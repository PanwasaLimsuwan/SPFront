{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"HeadcountByWorkGroup\",\n  props: {\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    this.drawChart();\n  },\n  watch: {\n    data: {\n      deep: true,\n      handler() {\n        this.drawChart();\n      }\n    }\n  },\n  methods: {\n    drawChart() {\n      const chartData = [{\n        values: this.data.values,\n        labels: this.data.labels,\n        type: \"pie\",\n        marker: {\n          colors: [\"#33FF57\", \"#3357FF\"]\n        }\n      }];\n      console.log(\"Chart Data to Plotly:\", chartData);\n      const layout = {\n        title: \"Head Count by WorkGroup\",\n        height: 450,\n        width: 450,\n        paper_bgcolor: \"rgba(0,0,0,0)\" // พื้นหลังด้านนอกเป็น transparent\n      };\n      Plotly.newPlot(\"headcount-workgroup\", chartData, layout).then(() => {\n        document.getElementById(\"headcount-workgroup\").on(\"plotly_click\", this.onSliceClick);\n      });\n    },\n    onSliceClick(eventData) {\n      if (eventData.points && eventData.points.length > 0) {\n        const sliceData = eventData.points[0];\n        const label = sliceData.label || sliceData.text;\n        if (label) {\n          this.$emit(\"filter\", label);\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","mounted","drawChart","watch","deep","handler","methods","chartData","values","labels","marker","colors","console","log","layout","title","height","width","paper_bgcolor","newPlot","then","document","getElementById","on","onSliceClick","eventData","points","length","sliceData","label","text","$emit"],"sources":["C:\\JecII\\SPFront\\src\\components\\HeadcountByWorkGroup.vue"],"sourcesContent":["<template>\r\n    <div id=\"headcount-workgroup\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"HeadcountByWorkGroup\",\r\n    props: {\r\n      data: {\r\n        type: Object,\r\n        required: true,\r\n      },\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    watch: {\r\n      data: {\r\n        deep: true,\r\n        handler() {\r\n          this.drawChart();\r\n        },\r\n      },\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            values: this.data.values,\r\n            labels: this.data.labels,\r\n            type: \"pie\",\r\n            marker: {\r\n              colors: [\"#33FF57\", \"#3357FF\"],\r\n            },\r\n          },\r\n        ];\r\n  \r\n        console.log(\"Chart Data to Plotly:\", chartData);\r\n  \r\n        const layout = {\r\n          title: \"Head Count by WorkGroup\",\r\n          height: 450,\r\n          width: 450,\r\n          paper_bgcolor: \"rgba(0,0,0,0)\", // พื้นหลังด้านนอกเป็น transparent\r\n        };\r\n  \r\n        Plotly.newPlot(\"headcount-workgroup\", chartData, layout).then(() => {\r\n          document\r\n            .getElementById(\"headcount-workgroup\")\r\n            .on(\"plotly_click\", this.onSliceClick);\r\n        });\r\n      },\r\n  \r\n      onSliceClick(eventData) {\r\n        if (eventData.points && eventData.points.length > 0) {\r\n          const sliceData = eventData.points[0];\r\n          const label = sliceData.label || sliceData.text;\r\n          if (label) {\r\n            this.$emit(\"filter\", label);\r\n          }\r\n        }\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #headcount-workgroup {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,KAAK,EAAE;IACLN,IAAI,EAAE;MACJO,IAAI,EAAE,IAAI;MACVC,OAAOA,CAAA,EAAG;QACR,IA