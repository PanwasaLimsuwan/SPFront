{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"ShiftcodeRequireSupport\",\n  props: {\n    data: Object\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const {\n        processes,\n        shiftA,\n        shiftB,\n        shiftC\n      } = this.data;\n      const chartData = [{\n        x: processes,\n        y: shiftA,\n        type: \"bar\",\n        name: \"Shiftcode : A\",\n        marker: {\n          color: \"yellow\"\n        }\n      }, {\n        x: processes,\n        y: shiftB,\n        type: \"bar\",\n        name: \"Shiftcode : B\",\n        marker: {\n          color: \"pink\"\n        }\n      }, {\n        x: processes,\n        y: shiftC,\n        type: \"bar\",\n        name: \"Shiftcode : C\",\n        marker: {\n          color: \"lightgreen\"\n        }\n      }];\n      const layout = {\n        title: \"Weekly Shiftcode Require Support\",\n        barmode: \"stack\",\n        height: 300,\n        xaxis: {\n          title: \"Process\"\n        },\n        yaxis: {\n          title: \"Count\",\n          range: [0, 20]\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"shiftcode-support-chart\", chartData, layout).then(() => {\n        document.getElementById(\"shiftcode-support-chart\").on(\"plotly_click\", this.onBarClick);\n      });\n    },\n    onBarClick(eventData) {\n      if (eventData.points && eventData.points.length > 0) {\n        const clickedShiftcode = eventData.points[0].data.name.split(\" \")[2];\n        console.log(\"Selected Shiftcode:\", clickedShiftcode);\n        this.$emit(\"filterShift\", clickedShiftcode);\n      }\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Object","mounted","drawChart","methods","processes","shiftA","shiftB","shiftC","chartData","x","y","type","marker","color","layout","title","barmode","height","xaxis","yaxis","range","responsive","newPlot","then","document","getElementById","on","onBarClick","eventData","points","length","clickedShiftcode","split","console","log","$emit"],"sources":["C:\\JecII\\SPFront\\src\\components\\ShiftcodeRequireSupport.vue"],"sourcesContent":["<template>\r\n  <div id=\"shiftcode-support-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"ShiftcodeRequireSupport\",\r\n  props: {\r\n    data: Object,\r\n  },\r\n  mounted() {\r\n    this.drawChart();\r\n  },\r\n  methods: {\r\n    drawChart() {\r\n      const { processes, shiftA, shiftB, shiftC } = this.data;\r\n\r\n      const chartData = [\r\n        {\r\n          x: processes,\r\n          y: shiftA,\r\n          type: \"bar\",\r\n          name: \"Shiftcode : A\",\r\n          marker: { color: \"yellow\" },\r\n        },\r\n        {\r\n          x: processes,\r\n          y: shiftB,\r\n          type: \"bar\",\r\n          name: \"Shiftcode : B\",\r\n          marker: { color: \"pink\" },\r\n        },\r\n        {\r\n          x: processes,\r\n          y: shiftC,\r\n          type: \"bar\",\r\n          name: \"Shiftcode : C\",\r\n          marker: { color: \"lightgreen\" },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Weekly Shiftcode Require Support\",\r\n        barmode: \"stack\",\r\n        height: 300,\r\n        xaxis: { title: \"Process\" },\r\n        yaxis: { title: \"Count\", range: [0, 20] },\r\n        responsive: true,\r\n      };\r\n\r\n      Plotly.newPlot(\"shiftcode-support-chart\", chartData, layout).then(() => {\r\n        document\r\n          .getElementById(\"shiftcode-support-chart\")\r\n          .on(\"plotly_click\", this.onBarClick);\r\n      });\r\n    },\r\n    onBarClick(eventData) {\r\n      if (eventData.points && eventData.points.length > 0) {\r\n        const clickedShiftcode = eventData.points[0].data.name.split(\" \")[2];\r\n        console.log(\"Selected Shiftcode:\", clickedShiftcode);\r\n        this.$emit(\"filterShift\", clickedShiftcode);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAKA,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,KAAK,EAAE;IACLC,IAAI,EAAEC;EACR,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACPD,SAASA,CAAA,EAAG;MACV,MAAM;QAAEE,SAAS;QAAEC,MAAM;QAAEC,MAAM;QAAEC;MAAO,IAAI,IAAI,CAACR,IAAI;MAEvD,MAAMS,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAEL,SAAS;QACZM,CAAC,EAAEL,MAAM;QACTM,IAAI,EAAE,KAAK;QACXd,IAAI,EAAE,eAAe;QACrBe,MAAM,EAAE;UAAEC,KAAK,EAAE;QAAS;MAC5B,CAAC,EACD;QACEJ,CAAC,EAAEL,SAAS;QACZM,CAAC,EAAEJ,MAAM;QACTK,IAAI,EAAE,KAAK;QACXd,IAAI,EAAE,eAAe;QACrBe,MAAM,EAAE;UAAEC,KAAK,EAAE;QAAO;MAC1B,CAAC,EACD;QACEJ,CAAC,EAAEL,SAAS;QACZM,CAAC,EAAEH,MAAM;QACTI,IAAI,EAAE,KAAK;QACXd,IAAI,EAAE,eAAe;QACrBe,MAAM,EAAE;UAAEC,KAAK,EAAE;QAAa;MAChC,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACbC,KAAK,EAAE,kCAAkC;QACzCC,OAAO,EAAE,OAAO;QAChBC,MAAM,EAAE,GAAG;QACXC,KAAK,EAAE;UAAEH,KAAK,EAAE;QAAU,CAAC;QAC3BI,KAAK,EAAE;UAAEJ,KAAK,EAAE,OAAO;UAAEK,KAAK,EAAE,CAAC,CAAC,EAAE,EAAE;QAAE,CAAC;QACzCC,UAAU,EAAE;MACd,CAAC;MAEDzB,MAAM,CAAC0B,OAAO,CAAC,yBAAyB,EAAEd,SAAS,EAAEM,MAAM,CAAC,CAACS,IAAI,CAAC,MAAM;QACtEC,QAAO,CACJC,cAAc,CAAC,yBAAyB,EACxCC,EAAE,CAAC,cAAc,EAAE,IAAI,CAACC,UAAU,CAAC;MACxC,CAAC,CAAC;IACJ,CAAC;IACDA,UAAUA,CAACC,SAAS,EAAE;MACpB,IAAIA,SAAS,CAACC,MAAK,IAAKD,SAAS,CAACC,MAAM,CAACC,MAAK,GAAI,CAAC,EAAE;QACnD,MAAMC,gBAAe,GAAIH,SAAS,CAACC,MAAM,CAAC,CAAC,CAAC,CAAC9B,IAAI,CAACF,IAAI,CAACmC,KAAK,CAAC,GAAG,CAAC,CAAC,CAAC,CAAC;QACpEC,OAAO,CAACC,GAAG,CAAC,qBAAqB,EAAEH,gBAAgB,CAAC;QACpD,IAAI,CAACI,KAAK,CAAC,aAAa,EAAEJ,gBAAgB,CAAC;MAC7C;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}