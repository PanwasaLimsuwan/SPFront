{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"WeeklyAbsentTrend\",\n  props: {\n    data: Object\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const chartData = [{\n        x: this.data.days,\n        y: this.data.absences,\n        type: \"scatter\",\n        mode: \"lines+markers\",\n        line: {\n          color: \"red\"\n        }\n      }];\n      const layout = {\n        title: \"Weekly Absent Trend\",\n        height: 300,\n        margin: {\n          l: 50,\n          r: 20,\n          t: 50,\n          b: 50\n        },\n        xaxis: {\n          title: \"Days\",\n          automargin: true\n        },\n        yaxis: {\n          title: \"Absences\",\n          range: [0, 50],\n          // กำหนดช่วงแกน y\n          tick0: 0,\n          dtick: 10 // ให้แสดง tick ทุก 10 หน่วย\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"weekly-absent-trend\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Object","mounted","drawChart","methods","chartData","x","days","y","absences","type","mode","line","color","layout","title","height","margin","l","r","t","b","xaxis","automargin","yaxis","range","tick0","dtick","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\WeeklyAbsentTrend.vue"],"sourcesContent":["<template>\r\n    <div id=\"weekly-absent-trend\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"WeeklyAbsentTrend\",\r\n    props: {\r\n      data: Object,\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            x: this.data.days,\r\n            y: this.data.absences,\r\n            type: \"scatter\",\r\n            mode: \"lines+markers\",\r\n            line: { color: \"red\" },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n        title: \"Weekly Absent Trend\",\r\n        height: 300,\r\n        margin: { l: 50, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Days\", automargin: true },\r\n        yaxis: {\r\n          title: \"Absences\",\r\n          range: [0, 50], // กำหนดช่วงแกน y\r\n          tick0: 0,\r\n          dtick: 10, // ให้แสดง tick ทุก 10 หน่วย\r\n        },\r\n        responsive: true,\r\n      };\r\n  \r\n        Plotly.newPlot(\"weekly-absent-trend\", chartData, layout);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #weekly-absent-trend {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,KAAK,EAAE;IACLC,IAAI,EAAEC;EACR,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACPD,SAASA,CAAA,EAAG;MACV,MAAME,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAE,IAAI,CAACN,IAAI,CAACO,IAAI;QACjBC,CAAC,EAAE,IAAI,CAACR,IAAI,CAACS,QAAQ;QACrBC,IAAI,EAAE,SAAS;QACfC,IAAI,EAAE,eAAe;QACrBC,IAAI,EAAE;UAAEC,KAAK,EAAE;QAAM;MACvB,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACfC,KAAK,EAAE,qBAAqB;QAC5BC,MAAM,EAAE,GAAG;QACXC,MAAM,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE;QAAG,CAAC;QACtCC,KAAK,EAAE;UAAEP,KAAK,EAAE,MAAM;UAAEQ,UAAU,EAAE;QAAK,CAAC;QAC1CC,KAAK,EAAE;UACLT,KAAK,EAAE,UAAU;UACjBU,KAAK,EAAE,CAAC,CAAC,EAAE,EAAE,CAAC;UAAE;UAChBC,KAAK,EAAE,CAAC;UACRC,KAAK,EAAE,EAAE,CAAE;QACb,CAAC;QACDC,UAAU,EAAE;MACd,CAAC;MAEC/B,MAAM,CAACgC,OAAO,CAAC,qBAAqB,EAAExB,SAAS,EAAES,MAAM,CAAC;IAC1D;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}