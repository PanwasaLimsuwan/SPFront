{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport Plotly from \"plotly.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"WorkedTimeChart\",\n  data() {\n    return {\n      data: []\n    };\n  },\n  mounted() {\n    this.fetchWorkedTimeData(); // เรียกใช้ฟังก์ชันเพื่อดึงข้อมูลเมื่อ component ถูก mount\n  },\n  methods: {\n    async fetchWorkedTimeData() {\n      try {\n        const response = await axios.get(\"http://localhost:5000/api/WorkedTimeChart\");\n        this.data = response.data; // เก็บข้อมูลจาก API\n        this.drawChart();\n      } catch (error) {\n        console.error(\"Error fetching worked time data:\", error);\n      }\n    },\n    drawChart() {\n      const chartData = [{\n        x: this.data.map(emp => emp.hours),\n        // นำค่าจำนวนชั่วโมงจากข้อมูล\n        y: this.data.map(emp => `${emp.firstname} ${emp.lastname}`),\n        // นำชื่อพนักงานจากข้อมูล\n        type: \"bar\",\n        orientation: \"h\",\n        marker: {\n          color: this.data.map(emp => emp.hours > 60 ? \"red\" : \"yellow\") // กำหนดสีตามจำนวนชั่วโมง\n        }\n      }];\n      const layout = {\n        title: \"Worked Time (60hrs./week)\",\n        height: 300,\n        margin: {\n          l: 150,\n          r: 20,\n          t: 50,\n          b: 50\n        },\n        xaxis: {\n          title: \"Hours\",\n          automargin: true\n        },\n        yaxis: {\n          automargin: true\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"worked-time-chart\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","axios","name","data","mounted","fetchWorkedTimeData","methods","response","get","drawChart","error","console","chartData","x","map","emp","hours","y","firstname","lastname","type","orientation","marker","color","layout","title","height","margin","l","r","t","b","xaxis","automargin","yaxis","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\WorkedTimeChart.vue"],"sourcesContent":["<template>\r\n  <div id=\"worked-time-chart\"></div>\r\n</template>\r\n\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\nimport axios from \"axios\";\r\n\r\n\r\nexport default {\r\n  name: \"WorkedTimeChart\",\r\n  data() {\r\n    return {\r\n      data: [],\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchWorkedTimeData();  // เรียกใช้ฟังก์ชันเพื่อดึงข้อมูลเมื่อ component ถูก mount\r\n  },\r\n  methods: {\r\n    async fetchWorkedTimeData() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:5000/api/WorkedTimeChart\");\r\n        this.data = response.data;  // เก็บข้อมูลจาก API\r\n        this.drawChart();\r\n      } catch (error) {\r\n        console.error(\"Error fetching worked time data:\", error);\r\n      }\r\n    },\r\n    drawChart() {\r\n      const chartData = [\r\n        {\r\n          x: this.data.map(emp => emp.hours),  // นำค่าจำนวนชั่วโมงจากข้อมูล\r\n          y: this.data.map(emp => `${emp.firstname} ${emp.lastname}`),  // นำชื่อพนักงานจากข้อมูล\r\n          type: \"bar\",\r\n          orientation: \"h\",\r\n          marker: {\r\n            color: this.data.map(emp => (emp.hours > 60 ? \"red\" : \"yellow\")),  // กำหนดสีตามจำนวนชั่วโมง\r\n          },\r\n        },\r\n      ];\r\n\r\n\r\n      const layout = {\r\n        title: \"Worked Time (60hrs./week)\",\r\n        height: 300,\r\n        margin: { l: 150, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Hours\", automargin: true },\r\n        yaxis: { automargin: true },\r\n        responsive: true,\r\n      };\r\n\r\n\r\n      Plotly.newPlot(\"worked-time-chart\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n\r\n<style scoped>\r\n#worked-time-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n\r\n\r\n\r\n"],"mappings":";AAMA,OAAOA,MAAK,MAAO,WAAW;AAC9B,OAAOC,KAAI,MAAO,OAAO;AAGzB,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLA,IAAI,EAAE;IACR,CAAC;EACH,CAAC;EACDC,OAA