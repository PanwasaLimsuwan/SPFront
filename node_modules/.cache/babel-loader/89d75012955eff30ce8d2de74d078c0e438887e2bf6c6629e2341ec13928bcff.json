{"ast":null,"code":"export default {\n  props: {\n    employee: {\n      type: Object,\n      required: true\n    },\n    skills: {\n      type: Array,\n      required: true\n    }\n  },\n  methods: {\n    getSkillColor(level) {\n      if (level === 3) return \"green\";\n      if (level === 2) return \"yellow\";\n      if (level === 1) return \"red\";\n      if (level === 0) return \"gray\";\n      return \"transparent\";\n    }\n  }\n};","map":{"version":3,"names":["props","employee","type","Object","required","skills","Array","methods","getSkillColor","level"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n    <div v-if=\"employee\" class=\"employee-section\">\r\n      <h3>{{ employee.Firstname }} {{ employee.Lastname }}</h3>\r\n      <div v-for=\"skill in skills\" :key=\"skill\">\r\n        <p>{{ skill }}: Level {{ employee[skill] }}</p>\r\n        <div\r\n          class=\"skill-bar\"\r\n          :style=\"{ \r\n            background: `linear-gradient(to right, ${getSkillColor(employee[skill])} ${(employee[skill] / 3) * 100}%, #ddd ${(employee[skill] / 3) * 100}%)`,\r\n            width: '100%'\r\n          }\"\r\n        ></div>\r\n      </div>\r\n    </div>\r\n    <p v-else>กรุณาเลือกพนักงาน</p>\r\n  </template>\r\n  \r\n  <script>\r\n  export default {\r\n    props: {\r\n      employee: {\r\n        type: Object,\r\n        required: true,\r\n      },\r\n      skills: {\r\n        type: Array,\r\n        required: true,\r\n      },\r\n    },\r\n    methods: {\r\n      getSkillColor(level) {\r\n        if (level === 3) return \"green\";\r\n        if (level === 2) return \"yellow\";\r\n        if (level === 1) return \"red\";\r\n        if (level === 0) return \"gray\";\r\n        return \"transparent\";\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .employee-section {\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .skill-bar {\r\n    height: 20px;\r\n    margin-bottom: 10px;\r\n    border-radius: 5px;\r\n    background-color: gray; /* Default */\r\n  }\r\n  </style>\r\n  "],"mappings":"AAkBE,eAAe;EACbA,KAAK,EAAE;IACLC,QAAQ,EAAE;MACRC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ,CAAC;IACDC,MAAM,EAAE;MACNH,IAAI,EAAEI,KAAK;MACXF,QAAQ,EAAE;IACZ;EACF,CAAC;EACDG,OAAO,EAAE;IACPC,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,OAAO;MAC/B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,QAAQ;MAChC,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,KAAK;MAC7B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,MAAM;MAC9B,OAAO,aAAa;IACtB;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}