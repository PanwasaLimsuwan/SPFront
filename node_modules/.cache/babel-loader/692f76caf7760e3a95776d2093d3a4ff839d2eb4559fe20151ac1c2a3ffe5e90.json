{"ast":null,"code":"import Plotly from \"plotly.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"FullySkilledPieChart\",\n  data() {\n    return {\n      pieData: {\n        values: [],\n        labels: [\"Fully Skilled\", \"Need Training\"]\n      }\n    };\n  },\n  mounted() {\n    this.fetchSkillData();\n  },\n  methods: {\n    async fetchSkillData() {\n      try {\n        const response = await axios.get('http://localhost:5000/api/FullySkill'); // เปลี่ยน URL ตามที่ API ของคุณใช้งาน\n        const data = response.data;\n\n        // กำหนดค่าที่ดึงมาให้กับ Pie Chart\n        this.pieData.values = [data[\"3\"], data[\"Other\"]];\n        this.drawChart();\n      } catch (error) {\n        console.error(\"Error fetching skill data:\", error);\n      }\n    },\n    drawChart() {\n      const chartData = [{\n        values: this.pieData.values,\n        // ค่าใน Pie Chart\n        labels: this.pieData.labels,\n        // Labels เช่น \"Fully Skilled\", \"Need Training\"\n        type: \"pie\",\n        marker: {\n          colors: [\"green\", \"red\"] // สีสำหรับแต่ละส่วน\n        }\n      }];\n      const layout = {\n        title: \"Skill Competency Overview\",\n        // ชื่อกราฟ\n        height: 450,\n        width: 450,\n        paper_bgcolor: 'rgba(0,0,0,0)' // พื้นหลังเป็น transparent\n      };\n      Plotly.newPlot(\"fully-skilled-pie-chart\", chartData, layout).then(() => {\n        document.getElementById(\"fully-skilled-pie-chart\").on(\"plotly_click\", this.onSliceClick);\n      });\n    },\n    onSliceClick(eventData) {\n      if (eventData.points && eventData.points.length > 0) {\n        const sliceLabel = eventData.points[0].label; // ดึง label (ชื่อของ slice)\n        this.$emit(\"filter\", sliceLabel); // ส่ง label ไปยัง parent component\n      }\n    }\n  }\n};","map":{"version":3,"names":["Plotly","axios","name","data","pieData","values","labels","mounted","fetchSkillData","methods","response","get","drawChart","error","console","chartData","type","marker","colors","layout","title","height","width","paper_bgcolor","newPlot","then","document","getElementById","on","onSliceClick","eventData","points","length","sliceLabel","label","$emit"],"sources":["C:\\JecII\\SPFront\\src\\components\\fullySkilledPieChart.vue"],"sourcesContent":["<template>\r\n  <div id=\"fully-skilled-pie-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"FullySkilledPieChart\",\r\n  data() {\r\n    return {\r\n      pieData: {\r\n        values: [],\r\n        labels: [\"Fully Skilled\", \"Need Training\"],\r\n      },\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchSkillData();\r\n  },\r\n  methods: {\r\n    async fetchSkillData() {\r\n      try {\r\n        const response = await axios.get('http://localhost:5000/api/FullySkill'); // เปลี่ยน URL ตามที่ API ของคุณใช้งาน\r\n        const data = response.data;\r\n\r\n        // กำหนดค่าที่ดึงมาให้กับ Pie Chart\r\n        this.pieData.values = [data[\"3\"], data[\"Other\"]];\r\n        this.drawChart();\r\n      } catch (error) {\r\n        console.error(\"Error fetching skill data:\", error);\r\n      }\r\n    },\r\n    drawChart() {\r\n      const chartData = [\r\n        {\r\n          values: this.pieData.values, // ค่าใน Pie Chart\r\n          labels: this.pieData.labels, // Labels เช่น \"Fully Skilled\", \"Need Training\"\r\n          type: \"pie\",\r\n          marker: {\r\n            colors: [\"green\", \"red\"], // สีสำหรับแต่ละส่วน\r\n          },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Skill Competency Overview\", // ชื่อกราฟ\r\n        height: 450,\r\n        width: 450,\r\n        paper_bgcolor: 'rgba(0,0,0,0)', // พื้นหลังเป็น transparent\r\n      };\r\n\r\n      Plotly.newPlot(\"fully-skilled-pie-chart\", chartData, layout).then(() => {\r\n        document\r\n          .getElementById(\"fully-skilled-pie-chart\")\r\n          .on(\"plotly_click\", this.onSliceClick);\r\n      });\r\n    },\r\n    onSliceClick(eventData) {\r\n      if (eventData.points && eventData.points.length > 0) {\r\n        const sliceLabel = eventData.points[0].label; // ดึง label (ชื่อของ slice)\r\n        this.$emit(\"filter\", sliceLabel); // ส่ง label ไปยัง parent component\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#fully-skilled-pie-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":"AAKA,OAAOA,MAAK,MAAO,WAAW;AAC9B,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE;QACPC,MAAM,EAAE,EAAE;QACVC,MAAM,EAAE,CAAC,eAAe,EAAE,eAAe;MAC3C;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,cAAc,CAAC,CAAC;EACvB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMT,KAAK,CAACU,GAAG,CAAC,sCAAsC,CAAC,EAAE;QAC1E,MAAMR,IAAG,GAAIO,QAAQ,CAACP,IAAI;;QAE1B;QACA,IAAI,CAACC,OAAO,CAACC,MAAK,GAAI,CAACF,IAAI,CAAC,GAAG,CAAC,EAAEA,IAAI,CAAC,OAAO,CAAC,CAAC;QAChD,IAAI,CAACS,SAAS,CAAC,CAAC;MAClB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,4BAA4B,EAAEA,KAAK,CAAC;MACpD;IACF,CAAC;IACDD,SAASA,CAAA,EAAG;MACV,MAAMG,SAAQ,GAAI,CAChB;QACEV,MAAM,EAAE,IAAI,CAACD,OAAO,CAACC,MAAM;QAAE;QAC7BC,MAAM,EAAE,IAAI,CAACF,OAAO,CAACE,MAAM;QAAE;QAC7BU,IAAI,EAAE,KAAK;QACXC,MAAM,EAAE;UACNC,MAAM,EAAE,CAAC,OAAO,EAAE,KAAK,CAAC,CAAE;QAC5B;MACF,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACbC,KAAK,EAAE,2BAA2B;QAAE;QACpCC,MAAM,EAAE,GAAG;QACXC,KAAK,EAAE,GAAG;QACVC,aAAa,EAAE,eAAe,CAAE;MAClC,CAAC;MAEDvB,MAAM,CAACwB,OAAO,CAAC,yBAAyB,EAAET,SAAS,EAAEI,MAAM,CAAC,CAACM,IAAI,CAAC,MAAM;QACtEC,QAAO,CACJC,cAAc,CAAC,yBAAyB,EACxCC,EAAE,CAAC,cAAc,EAAE,IAAI,CAACC,YAAY,CAAC;MAC1C,CAAC,CAAC;IACJ,CAAC;IACDA,YAAYA,CAACC,SAAS,EAAE;MACtB,IAAIA,SAAS,CAACC,MAAK,IAAKD,SAAS,CAACC,MAAM,CAACC,MAAK,GAAI,CAAC,EAAE;QACnD,MAAMC,UAAS,GAAIH,SAAS,CAACC,MAAM,CAAC,CAAC,CAAC,CAACG,KAAK,EAAE;QAC9C,IAAI,CAACC,KAAK,CAAC,QAAQ,EAAEF,UAAU,CAAC,EAAE;MACpC;IACF;EACF;AACF,CAAC