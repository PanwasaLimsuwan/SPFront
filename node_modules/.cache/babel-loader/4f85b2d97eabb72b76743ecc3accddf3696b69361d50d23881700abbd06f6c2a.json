{"ast":null,"code":"export default {\n  name: \"EmployeeSkillTable\",\n  data() {\n    return {\n      employees: [],\n      // รายการพนักงาน\n      skills: [\"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"] // รายการทักษะ\n    };\n  },\n  methods: {\n    async fetchEmployeeSkills() {\n      try {\n        const response = await axios.get(\"http://localhost:5000/api/EmployeeSkill\");\n        this.employees = response.data;\n      } catch (error) {\n        console.error(\"There was an error fetching the data:\", error);\n      }\n    },\n    selectEmployee(employee) {\n      // Emit ข้อมูลพนักงานที่ถูกเลือกไปยังพ่อแม่คอมโพเนนต์\n      this.$emit('selectEmployee', employee);\n    }\n  },\n  mounted() {\n    this.fetchEmployeeSkills();\n  }\n};","map":{"version":3,"names":["name","data","employees","skills","methods","fetchEmployeeSkills","response","axios","get","error","console","selectEmployee","employee","$emit","mounted"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillTable.vue"],"sourcesContent":["<template>\r\n  <div class=\"employee-skill-table\">\r\n    <h3>Employee Skill</h3>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th>No.</th>\r\n          <th>EmpID</th>\r\n          <th>Firstname</th>\r\n          <th>Lastname</th>\r\n          <th v-for=\"skill in skills\" :key=\"skill\">{{ skill }}</th>\r\n          <th>Select</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(employee, index) in employees\" :key=\"employee.empID\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ employee.empID }}</td>\r\n          <td>{{ employee.firstName }}</td>\r\n          <td>{{ employee.lastName }}</td>\r\n          <td\r\n            v-for=\"skill in skills\"\r\n            :key=\"skill\"\r\n            :class=\"getSkillLevelClass(employee[skill])\"\r\n          >\r\n            {{ employee[skill] }}\r\n          </td>\r\n          <td>\r\n            <button @click=\"selectEmployee(employee)\">\r\n              <img src=\"skill.png\" alt=\"Skill\" class=\"skill-icon\" />\r\n            </button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"EmployeeSkillTable\",\r\n  data() {\r\n    return {\r\n      employees: [],  // รายการพนักงาน\r\n      skills: [\r\n        \"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"\r\n      ],  // รายการทักษะ\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchEmployeeSkills() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:5000/api/EmployeeSkill\");\r\n        this.employees = response.data;\r\n      } catch (error) {\r\n        console.error(\"There was an error fetching the data:\", error);\r\n      }\r\n    },\r\n    selectEmployee(employee) {\r\n      // Emit ข้อมูลพนักงานที่ถูกเลือกไปยังพ่อแม่คอมโพเนนต์\r\n      this.$emit('selectEmployee', employee);\r\n    },\r\n  },\r\n  mounted() {\r\n    this.fetchEmployeeSkills();\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAuCA,eAAe;EACbA,IAAI,EAAE,oBAAoB;EAC1BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MAAG;MAChBC,MAAM,EAAE,CACN,UAAU,EAAE,WAAW,EAAE,cAAc,EAAE,cAAc,EAAE,cAAc,EAAE,YAAW,CACrF,CAAG;IACN,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,mBAAmBA,CAAA,EAAG;MAC1B,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAACC,GAAG,CAAC,yCAAyC,CAAC;QAC3E,IAAI,CAACN,SAAQ,GAAII,QAAQ,CAACL,IAAI;MAChC,EAAE,OAAOQ,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,uCAAuC,EAAEA,KAAK,CAAC;MAC/D;IACF,CAAC;IACDE,cAAcA,CAACC,QAAQ,EAAE;MACvB;MACA,IAAI,CAACC,KAAK,CAAC,gBAAgB,EAAED,QAAQ,CAAC;IACxC;EACF,CAAC;EACDE,OAAOA,CAAA,EAAG;IACR,IAAI,CAACT,mBAAmB,CAAC,CAAC;EAC5B;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}