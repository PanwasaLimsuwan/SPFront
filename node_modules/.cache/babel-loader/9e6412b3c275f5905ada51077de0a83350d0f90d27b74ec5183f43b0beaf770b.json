{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.filter.js\";\nimport \"core-js/modules/esnext.iterator.map.js\";\nimport Plotly from \"plotly.js\";\nexport default {\n  name: \"BarChart\",\n  props: {\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    this.drawChart();\n  },\n  watch: {\n    data: {\n      deep: true,\n      handler() {\n        this.drawChart();\n      }\n    }\n  },\n  methods: {\n    drawChart() {\n      // ตรวจสอบว่า data ที่รับมาจาก props มีการจัดการแล้วหรือไม่\n      console.log(\"Data from API:\", this.data);\n      const chartData = [{\n        x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\n        // เพิ่ม Process = JUNB\n        y: this.data.filter(item => item.Process === \"ASSY\").map(item => item.mployeeCount),\n        name: \"Inspection\",\n        type: \"bar\",\n        text: [2, 2, 2, 1],\n        // ตัวเลขที่จะแสดง\n        textposition: \"auto\",\n        // แสดงบน bar\n        marker: {\n          color: \"#76c7c0\"\n        }\n      }, {\n        x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\n        y: this.data.filter(item => item.Process === \"MOKU\").map(item => item.EmployeeCount),\n        name: \"Operation\",\n        type: \"bar\",\n        text: [1, 0, 1, 0],\n        textposition: \"auto\",\n        marker: {\n          color: \"#ff9800\"\n        }\n      }, {\n        x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\n        y: this.data.filter(item => item.Process === \"CSAT\").map(item => item.EmployeeCount),\n        name: \"Machine:SAB#1\",\n        type: \"bar\",\n        text: [0, 0, 1, 0],\n        textposition: \"auto\",\n        marker: {\n          color: \"#ffc107\"\n        }\n      }, {\n        x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\n        y: this.data.filter(item => item.Process === \"JUNB\").map(item => item.EmployeeCount),\n        name: \"Machine:SAB#2\",\n        type: \"bar\",\n        text: [0, 0, 1, 0],\n        textposition: \"auto\",\n        marker: {\n          color: \"#8bc34a\"\n        }\n      }, {\n        x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\n        y: [0, 0, 1, 0],\n        name: \"Machine:SAB#3\",\n        type: \"bar\",\n        text: [0, 0, 1, 0],\n        textposition: \"auto\",\n        marker: {\n          color: \"#2196f3\"\n        }\n      }, {\n        x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\n        y: this.data.filter(item => item.Process === \"ASSY\").map(item => item.EmployeeCount),\n        name: \"Inspection\",\n        type: \"bar\",\n        text: [1, 0, 0, 1],\n        textposition: \"auto\",\n        marker: {\n          color: \"#e91e63\"\n        }\n      }];\n      const layout = {\n        title: \"Require Support (Process)\",\n        barmode: \"stack\",\n        height: 400,\n        width: 700,\n        legend: {\n          orientation: \"v\",\n          x: 1.1,\n          y: 1\n        },\n        xaxis: {\n          title: \"Process\"\n        },\n        yaxis: {\n          title: \"Employees\"\n        }\n      };\n      Plotly.newPlot(\"bar-chart\", chartData, layout).then(chart => {\n        chart.on(\"plotly_click\", data => {\n          if (data.points && data.points.length > 0) {\n            const clickedSkill = data.points[0].data.name; // ชื่อ skill\n            this.$emit(\"filterSkill\", clickedSkill); // ส่ง event กลับไปที่ parent\n            console.log(\"Clicked Skill:\", clickedSkill); // Debug\n          } else {\n            console.warn(\"No points clicked!\");\n          }\n        });\n      });\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","mounted","drawChart","watch","deep","handler","methods","console","log","chartData","x","y","filter","item","Process","map","mployeeCount","text","textposition","marker","color","EmployeeCount","layout","title","barmode","height","width","legend","orientation","xaxis","yaxis","newPlot","then","chart","on","points","length","clickedSkill","$emit","warn"],"sources":["C:\\JecII\\SPFront\\src\\components\\BarChart.vue"],"sourcesContent":["<template>\r\n  <div id=\"bar-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"BarChart\",\r\n  props: {\r\n    data: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n  },\r\n  mounted() {\r\n    this.drawChart();\r\n  },\r\n  watch: {\r\n    data: {\r\n      deep: true,\r\n      handler() {\r\n        this.drawChart();\r\n      },\r\n    },\r\n  },\r\n  methods: {\r\n    drawChart() {\r\n      // ตรวจสอบว่า data ที่รับมาจาก props มีการจัดการแล้วหรือไม่\r\n      console.log(\"Data from API:\", this.data);\r\n\r\n      const chartData = [\r\n        {\r\n          x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"], // เพิ่ม Process = JUNB\r\n          y: this.data.filter(item => item.Process === \"ASSY\").map(item => item.mployeeCount),\r\n          name: \"Inspection\",\r\n          type: \"bar\",\r\n          text: [2, 2, 2, 1], // ตัวเลขที่จะแสดง\r\n          textposition: \"auto\", // แสดงบน bar\r\n          marker: { color: \"#76c7c0\" },\r\n        },\r\n        {\r\n          x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\r\n          y: this.data.filter(item => item.Process === \"MOKU\").map(item => item.EmployeeCount),\r\n          name: \"Operation\",\r\n          type: \"bar\",\r\n          text: [1, 0, 1, 0],\r\n          textposition: \"auto\",\r\n          marker: { color: \"#ff9800\" },\r\n        },\r\n        {\r\n          x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\r\n          y: this.data.filter(item => item.Process === \"CSAT\").map(item => item.EmployeeCount),\r\n          name: \"Machine:SAB#1\",\r\n          type: \"bar\",\r\n          text: [0, 0, 1, 0],\r\n          textposition: \"auto\",\r\n          marker: { color: \"#ffc107\" },\r\n        },\r\n        {\r\n          x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\r\n          y: this.data.filter(item => item.Process === \"JUNB\").map(item => item.EmployeeCount),\r\n          name: \"Machine:SAB#2\",\r\n          type: \"bar\",\r\n          text: [0, 0, 1, 0],\r\n          textposition: \"auto\",\r\n          marker: { color: \"#8bc34a\" },\r\n        },\r\n        {\r\n          x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\r\n          y: [0, 0, 1, 0],\r\n          name: \"Machine:SAB#3\",\r\n          type: \"bar\",\r\n          text: [0, 0, 1, 0],\r\n          textposition: \"auto\",\r\n          marker: { color: \"#2196f3\" },\r\n        },\r\n        {\r\n          x: [\"ASSY\", \"MOKU\", \"CSAT\", \"JUNB\"],\r\n          y: this.data.filter(item => item.Process === \"ASSY\").map(item => item.EmployeeCount),\r\n          name: \"Inspection\",\r\n          type: \"bar\",\r\n          text: [1, 0, 0, 1],\r\n          textposition: \"auto\",\r\n          marker: { color: \"#e91e63\" },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Require Support (Process)\",\r\n        barmode: \"stack\",\r\n        height: 400,\r\n        width: 700,\r\n        legend: { orientation: \"v\", x: 1.1, y: 1 },\r\n        xaxis: { title: \"Process\" },\r\n        yaxis: { title: \"Employees\" },\r\n      };\r\n\r\n      Plotly.newPlot(\"bar-chart\", chartData, layout).then((chart) => {\r\n        chart.on(\"plotly_click\", (data) => {\r\n          if (data.points && data.points.length > 0) {\r\n            const clickedSkill = data.points[0].data.name; // ชื่อ skill\r\n            this.$emit(\"filterSkill\", clickedSkill); // ส่ง event กลับไปที่ parent\r\n            console.log(\"Clicked Skill:\", clickedSkill); // Debug\r\n          } else {\r\n            console.warn(\"No points clicked!\");\r\n          }\r\n        });\r\n      });\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#bar-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";;;AAKA,OAAOA,MAAK,M