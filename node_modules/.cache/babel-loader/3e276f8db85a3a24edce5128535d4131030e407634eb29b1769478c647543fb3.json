{"ast":null,"code":"import axios from \"axios\";\nexport default {\n  props: {\n    skills: {\n      type: Array,\n      required: true\n    },\n    empId: {\n      type: Number,\n      required: true\n    }\n  },\n  data() {\n    return {\n      employee: null\n    };\n  },\n  watch: {\n    empId(newEmpId) {\n      console.log(\"Fetching skill data for EmpID:\", newEmpId); // เพิ่ม console.log เพื่อตรวจสอบ empId\n      if (newEmpId) {\n        this.fetchEmployeeSkill(newEmpId); // เรียกฟังก์ชันดึงข้อมูลเมื่อ empId เปลี่ยน\n      }\n    }\n  },\n  methods: {\n    async fetchEmployeeSkill() {\n      try {\n        const response = await axios.get(`http://localhost:5000/api/EmployeeSkillSection/${this.empId}`);\n        console.log(\"Employee Skill Data:\", response.data); // เพิ่ม console.log เพื่อตรวจสอบข้อมูลจาก API\n        if (response.data) {\n          this.employee = response.data; // เก็บข้อมูลที่ได้จาก API\n        }\n      } catch (error) {\n        console.error(\"Error fetching employee data:\", error);\n      }\n    },\n    getSkillColor(level) {\n      if (level === 3) return \"green\";\n      if (level === 2) return \"yellow\";\n      if (level === 1) return \"red\";\n      if (level === 0) return \"gray\";\n      return \"transparent\";\n    }\n  },\n  mounted() {\n    console.log(\"Current Employee Data:\", this.employee); // เพิ่ม console.log เพื่อตรวจสอบข้อมูลพนักงาน\n    if (this.empId) {\n      this.fetchEmployeeSkill(); // เรียก API ตอนที่ component ถูก mount\n    }\n  }\n};","map":{"version":3,"names":["axios","props","skills","type","Array","required","empId","Number","data","employee","watch","newEmpId","console","log","fetchEmployeeSkill","methods","response","get","error","getSkillColor","level","mounted"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"employee\" class=\"employee-section\">\r\n    <h3>{{ employee.firstName }} {{ employee.lastName }}</h3>\r\n    <div v-for=\"skill in skills\" :key=\"skill\">\r\n      <p>{{ skill }}: Level {{ employee[skill] }}</p>\r\n      <div\r\n        class=\"skill-bar\"\r\n        :style=\"{ \r\n          background: `linear-gradient(to right, ${getSkillColor(employee[skill])} ${(employee[skill] / 3) * 100}%, #ddd ${(employee[skill] / 3) * 100}%)`,\r\n          width: '100%'\r\n        }\"\r\n      ></div>\r\n    </div>\r\n  </div>\r\n  <p v-else>กรุณาเลือกพนักงาน</p>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  props: {\r\n    skills: {\r\n      type: Array,\r\n      required: true,\r\n    },\r\n    empId: {\r\n      type: Number,\r\n      required: true,\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      employee: null,\r\n    };\r\n  },\r\n  watch: {\r\n    empId(newEmpId) {\r\n      console.log(\"Fetching skill data for EmpID:\", newEmpId);  // เพิ่ม console.log เพื่อตรวจสอบ empId\r\n      if (newEmpId) {\r\n        this.fetchEmployeeSkill(newEmpId);  // เรียกฟังก์ชันดึงข้อมูลเมื่อ empId เปลี่ยน\r\n      }\r\n    },\r\n  },\r\n  methods: {\r\n    async fetchEmployeeSkill() {\r\n      try {\r\n        const response = await axios.get(`http://localhost:5000/api/EmployeeSkillSection/${this.empId}`);\r\n        console.log(\"Employee Skill Data:\", response.data);  // เพิ่ม console.log เพื่อตรวจสอบข้อมูลจาก API\r\n        if (response.data) {\r\n          this.employee = response.data;  // เก็บข้อมูลที่ได้จาก API\r\n        }\r\n      } catch (error) {\r\n        console.error(\"Error fetching employee data:\", error);\r\n      }\r\n    },\r\n    getSkillColor(level) {\r\n      if (level === 3) return \"green\";\r\n      if (level === 2) return \"yellow\";\r\n      if (level === 1) return \"red\";\r\n      if (level === 0) return \"gray\";\r\n      return \"transparent\";\r\n    },\r\n  },\r\n  mounted() {\r\n    console.log(\"Current Employee Data:\", this.employee);  // เพิ่ม console.log เพื่อตรวจสอบข้อมูลพนักงาน\r\n    if (this.empId) {\r\n      this.fetchEmployeeSkill();  // เรียก API ตอนที่ component ถูก mount\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.employee-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.skill-bar {\r\n  height: 20px;\r\n  margin-bottom: 10px;\r\n  border-radius: 5px;\r\n  background-color: gray; /* Default */\r\n}\r\n</style>\r\n"],"mappings":"AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ,CAAC;IACDC,KAAK,EAAE;MACLH,IAAI,EAAEI,MAAM;MACZF,QAAQ,EAAE;IACZ;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,KAAK,EAAE;IACLJ,KAAKA,CAACK,QAAQ,EAAE;MACdC,OAAO,CAACC,GAAG,CAAC,gCAAgC,EAAEF,QAAQ,CAAC,EAAG;MAC1D,IAAIA,QAAQ,EAAE;QACZ,IAAI,CAACG,kBAAkB,CAACH,QAAQ,CAAC,EAAG;MACtC;IACF;EACF,CAAC;EACDI,OAAO,EAAE;IACP,MAAMD,kBAAkBA,CAAA,EAAG;MACzB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMhB,KAAK,CAACiB,GAAG,CAAC,kDAAkD,IAAI,CAACX,KAAK,EAAE,CAAC;QAChGM,OAAO,CAACC,GAAG,CAAC,sBAAsB,EAAEG,QAAQ,CAACR,IAAI,CAAC,EAAG;QACrD,IAAIQ,QAAQ,CAACR,IAAI,EAAE;UACjB,IAAI,CAACC,QAAO,GAAIO,QAAQ,CAACR,IAAI,EAAG;QAClC;MACF,EAAE,OAAOU,KAAK,EAAE;QACdN,OAAO,CAACM,KAAK,CAAC,+BAA+B,EAAEA,KAAK,CAAC;MACvD;IACF,CAAC;IACDC,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,OAAO;MAC/B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,QAAQ;MAChC,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,KAAK;MAC7B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,MAAM;MAC9B,OAAO,aAAa;IACtB;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACRT,OAAO,CAACC,GAAG,CAAC,wBAAwB,EAAE,IAAI,CAACJ,QAAQ,CAAC,EAAG;IACvD,IAAI,IAAI,CAACH,KAAK,EAAE;MACd,IAAI,CAACQ,kBAAkB,CAAC,CAAC,EAAG;IAC9B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}