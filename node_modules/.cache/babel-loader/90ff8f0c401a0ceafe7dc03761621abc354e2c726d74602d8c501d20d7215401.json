{"ast":null,"code":"import axios from 'axios';\nexport default {\n  props: {\n    skills: {\n      type: Array,\n      required: true,\n      default: () => ['Material', 'Operation', 'Machine:SAB#1', 'Machine:SAB#2', 'Machine:SAB#3', 'Inspection']\n    },\n    empId: {\n      type: Number,\n      required: true\n    }\n  },\n  data() {\n    return {\n      employee: null\n    };\n  },\n  mounted() {\n    this.fetchEmployeeSkills(this.empId);\n  },\n  methods: {\n    async fetchEmployeeSkills(empId) {\n      try {\n        const response = await axios.get(`http://your-api-url/api/EmployeeSkillSection/${empId}`);\n        this.employee = response.data;\n      } catch (error) {\n        console.error(\"Error fetching employee data:\", error);\n      }\n    },\n    getSkillColor(level) {\n      if (level === 3) return \"green\";\n      if (level === 2) return \"yellow\";\n      if (level === 1) return \"red\";\n      if (level === 0) return \"gray\";\n      return \"transparent\";\n    }\n  }\n};","map":{"version":3,"names":["axios","props","skills","type","Array","required","default","empId","Number","data","employee","mounted","fetchEmployeeSkills","methods","response","get","error","console","getSkillColor","level"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"employee\" class=\"employee-section\">\r\n    <h3>{{ employee.firstName }} {{ employee.lastName }}</h3>\r\n    <div v-for=\"skill in skills\" :key=\"skill\">\r\n      <p>{{ skill }}: Level {{ employee[skill] }}</p>\r\n      <div\r\n        class=\"skill-bar\"\r\n        :style=\"{ \r\n          background: `linear-gradient(to right, ${getSkillColor(employee[skill])} ${(employee[skill] / 3) * 100}%, #ddd ${(employee[skill] / 3) * 100}%)`,\r\n          width: '100%'\r\n        }\"\r\n      ></div>\r\n    </div>\r\n  </div>\r\n  <p v-else>กรุณาเลือกพนักงาน</p>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  props: {\r\n    skills: {\r\n      type: Array,\r\n      required: true,\r\n      default: () => ['Material', 'Operation', 'Machine:SAB#1', 'Machine:SAB#2', 'Machine:SAB#3', 'Inspection']\r\n    },\r\n    empId: {\r\n      type: Number,\r\n      required: true,\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      employee: null,\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchEmployeeSkills(this.empId);\r\n  },\r\n  methods: {\r\n    async fetchEmployeeSkills(empId) {\r\n      try {\r\n        const response = await axios.get(`http://your-api-url/api/EmployeeSkillSection/${empId}`);\r\n        this.employee = response.data;\r\n      } catch (error) {\r\n        console.error(\"Error fetching employee data:\", error);\r\n      }\r\n    },\r\n    getSkillColor(level) {\r\n      if (level === 3) return \"green\";\r\n      if (level === 2) return \"yellow\";\r\n      if (level === 1) return \"red\";\r\n      if (level === 0) return \"gray\";\r\n      return \"transparent\";\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.employee-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.skill-bar {\r\n  height: 20px;\r\n  margin-bottom: 10px;\r\n  border-radius: 5px;\r\n  background-color: gray;\r\n}\r\n\r\n.skill-bar {\r\n  transition: background 0.5s ease;\r\n}\r\n</style>\r\n"],"mappings":"AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE,IAAI;MACdC,OAAO,EAAEA,CAAA,KAAM,CAAC,UAAU,EAAE,WAAW,EAAE,eAAe,EAAE,eAAe,EAAE,eAAe,EAAE,YAAY;IAC1G,CAAC;IACDC,KAAK,EAAE;MACLJ,IAAI,EAAEK,MAAM;MACZH,QAAQ,EAAE;IACZ;EACF,CAAC;EACDI,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,mBAAmB,CAAC,IAAI,CAACL,KAAK,CAAC;EACtC,CAAC;EACDM,OAAO,EAAE;IACP,MAAMD,mBAAmBA,CAACL,KAAK,EAAE;MAC/B,IAAI;QACF,MAAMO,QAAO,GAAI,MAAMd,KAAK,CAACe,GAAG,CAAC,gDAAgDR,KAAK,EAAE,CAAC;QACzF,IAAI,CAACG,QAAO,GAAII,QAAQ,CAACL,IAAI;MAC/B,EAAE,OAAOO,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,+BAA+B