rocessData);\r\n      const skillGroups = [\"Inspection\", \"Machine:SAB#1\", \"Machine:SAB#2\", \"Machine:SAB#3\", \"Material\", \"Operation\"];\r\n      \r\n      const chartData = skillGroups.map((skillGroup) => {\r\n        return {\r\n          x: processes,\r\n          y: processes.map((process) => processData[process][skillGroup] || 0),\r\n          name: skillGroup,\r\n          type: \"bar\",\r\n          text: processes.map((process) => processData[process][skillGroup] || 0),\r\n          textposition: \"auto\",\r\n          marker: { color: \"#76c7c0\" }, // ปรับสีของกราฟ\r\n        };\r\n      });\r\n\r\n      const layout = {\r\n        title: \"Require Support (Process)\",\r\n        barmode: \"stack\",\r\n        height: 400,\r\n        width: 700,\r\n        legend: { orientation: \"v\", x: 1.1, y: 1 },\r\n        xaxis: { title: \"Process\" },\r\n        yaxis: { title: \"Employees\" },\r\n      };\r\n\r\n      Plotly.newPlot(\"bar-chart\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#bar-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";;;AAKA,OAAOA,MAAK,MAAO,WAAW;AAC9B,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE;IAChB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,iBAAiB,CAAC,CAAC;EAC1B,CAAC;EACDC,KAAK,EAAE;IACLH,YAAY,EAAE;MACZI,OAAOA,CAAA,EAAG;QACR,IAAI,CAACC,SAAS,CAAC,CAAC;MAClB,CAAC;MACDC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,OAAO,EAAE;IACP;IACA,MAAML,iBAAiBA,CAAA,EAAG;MACxB,IAAI;QACF,MAAMM,QAAO,GAAI,MAAMX,KAAK,CAACY,GAAG,CAAC,oCAAoC,CAAC;QACtE,IAAI,CAACT,YAAW,GAAIQ,QAAQ,CAACT,IAAI;MACnC,EAAE,OAAOW,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,gCAAgC,EAAEA,KAAK,CAAC;MACxD;IACF,CAAC;IAED;IACAL,SAASA,CAAA,EAAG;MACV,MAAMO,WAAU,GAAI,IAAI,CAACZ,YAAY,CAACa,MAAM,CAAC,CAACC,GAAG,EAAEC,IAAI,KAAK;QAC1D,IAAI,CAACD,GAAG,CAACC,IAAI,CAACC,OAAO,CAAC,EAAE;UACtBF,GAAG,CAACC,IAAI,CAACC,OAAO,IAAI,CAAC,CAAC;QACxB;QACAF,GAAG,CAACC,IAAI,CAACC,OAAO,CA