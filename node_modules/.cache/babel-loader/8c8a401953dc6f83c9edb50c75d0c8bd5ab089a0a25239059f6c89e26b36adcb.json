{"ast":null,"code":"export default {\n  name: \"EmployeeTable\",\n  props: {\n    employees: {\n      type: Array,\n      required: true\n    }\n  },\n  methods: {\n    getStatusClass(status) {\n      return {\n        \"status-in-cleanroom\": status === \"In Cleanroom\",\n        \"status-out-cleanroom\": status === \"Out Cleanroom\",\n        \"status-missing\": status === \"ขาดงาน\"\n      };\n    },\n    getDivisionClass(division) {\n      return {\n        \"division-ism\": division === \"ISM\",\n        \"division-rnd\": division === \"RND\",\n        \"division-qa\": division === \"QA\",\n        \"division-default\": !division // ใช้ default class ถ้าไม่มีค่า\n      };\n    }\n  }\n};","map":{"version":3,"names":["name","props","employees","type","Array","required","methods","getStatusClass","status","getDivisionClass","division"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeTable.vue"],"sourcesContent":["<template>\r\n  <div class=\"employee-table\">\r\n    <h3>Head Count</h3>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th>No.</th>\r\n          <th>EmpID</th>\r\n          <th>Firstname</th>\r\n          <th>Lastname</th>\r\n          <th class=\"datetime-column\">Date-time</th>          <th>Gate No</th>\r\n          <th>Division</th>\r\n          <th>Department</th>\r\n          <th>Biz</th>\r\n          <th>Process</th>\r\n          <th>CourseGroup</th>\r\n          <th>WorkGroup</th>\r\n          <th>Status</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(employee, index) in employees\" :key=\"index\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ employee.EmpID }}</td>\r\n          <td>{{ employee.Firstname }}</td>\r\n          <td>{{ employee.Lastname }}</td>\r\n          <td class=\"datetime-column\">{{ employee.Datetime || \"-\" }}</td>\r\n          <td>{{ employee.GateNo }}</td>\r\n          <td>{{ employee.Division }}</td>\r\n          <td>{{ employee.Department }}</td>\r\n          <td>{{ employee.Biz }}</td>\r\n          <td>{{ employee.Process }}</td>\r\n          <td>{{ employee.CourseGroup }}</td>\r\n          <td>{{ employee.WorkGroup }}</td>\r\n          <td :class=\"getStatusClass(employee.Status)\">\r\n            {{ employee.Status }}\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"EmployeeTable\",\r\n  props: {\r\n    employees: {\r\n      type: Array,\r\n      required: true,\r\n    },\r\n  },\r\n  methods: {\r\n    getStatusClass(status) {\r\n      return {\r\n        \"status-in-cleanroom\": status === \"In Cleanroom\",\r\n        \"status-out-cleanroom\": status === \"Out Cleanroom\",\r\n        \"status-missing\": status === \"ขาดงาน\",\r\n      };\r\n    },\r\n    getDivisionClass(division) {\r\n  return {\r\n    \"division-ism\": division === \"ISM\",\r\n    \"division-rnd\": division === \"RND\",\r\n    \"division-qa\": division === \"QA\",\r\n    \"division-default\": !division, // ใช้ default class ถ้าไม่มีค่า\r\n  };\r\n},\r\n  },\r\n};\r\n</script>\r\n\r\n  <style scoped>\r\n    .employee-table {\r\n      margin-top: 20px;\r\n    }\r\n\r\n    table {\r\n      width: 100%;\r\n      border-collapse: collapse;\r\n    }\r\n\r\n    th,\r\n    td {\r\n      padding: 10px;\r\n      text-align: center;\r\n      border: 1px solid #ddd;\r\n    }\r\n\r\n    th {\r\n      background-color: #f4f4f4;\r\n    }\r\n\r\n    .status-in-cleanroom {\r\n      color: green;\r\n    }\r\n\r\n    .status-out-cleanroom {\r\n      color: orange;\r\n    }\r\n\r\n    .status-missing {\r\n      color: red;\r\n    }\r\n\r\n    .datetime-column {\r\n  white-space: nowrap; /* ป้องกันการตัดข้อความ */\r\n}\r\n  </style>\r\n"],"mappings":"AA4CA,eAAe;EACbA,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IACLC,SAAS,EAAE;MACTC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,cAAcA,CAACC,MAAM,EAAE;MACrB,OAAO;QACL,qBAAqB,EAAEA,MAAK,KAAM,cAAc;QAChD,sBAAsB,EAAEA,MAAK,KAAM,eAAe;QAClD,gBAAgB,EAAEA,MAAK,KAAM;MAC/B,CAAC;IACH,CAAC;IACDC,gBAAgBA,CAACC,QAAQ,EAAE;MAC7B,OAAO;QACL,cAAc,EAAEA,QAAO,KAAM,KAAK;QAClC,cAAc,EAAEA,QAAO,KAAM,KAAK;QAClC,aAAa,EAAEA,QAAO,KAAM,IAAI;QAChC,kBAAkB,EAAE,CAACA,QAAQ,CAAE;MACjC,CAAC;IACH;EACE;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}