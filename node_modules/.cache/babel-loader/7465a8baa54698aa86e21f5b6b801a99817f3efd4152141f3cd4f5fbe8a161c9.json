{"ast":null,"code":"import { openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  id: \"weekly-absent-trend\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1);\n}","map":{"version":3,"names":["id","_createElementBlock","_hoisted_1"],"sources":["C:\\JecII\\SPFront\\src\\components\\WeeklyAbsentTrend.vue"],"sourcesContent":["<template>\r\n  <div id=\"weekly-absent-trend\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"WeeklyAbsentTrend\",\r\n  props: {\r\n    data: Object, // รับข้อมูลจาก API ที่ส่งมา\r\n  },\r\n  mounted() {\r\n    this.drawChart();\r\n  },\r\n  methods: {\r\n    drawChart() {\r\n      const chartData = [\r\n        {\r\n          x: this.data.map(item => item.Absences), // ใช้ WeekNumber เป็นค่าแกน x\r\n          y: this.data.map(item => item.Wee),   // ใช้ Absences เป็นค่าแกน y\r\n          type: \"scatter\",\r\n          mode: \"lines+markers\",\r\n          line: { color: \"red\" },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Weekly Absent Trend\",\r\n        height: 300,\r\n        margin: { l: 50, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Week Number\", automargin: true },\r\n        yaxis: {\r\n          title: \"Absences\",\r\n          range: [0, Math.max(...this.data.map(item => item.Absences)) + 5], // กำหนดช่วงของแกน y ให้เพิ่มจากข้อมูลสูงสุด\r\n          tick0: 0,\r\n          dtick: 1, // ให้แสดง tick ทุก 1 หน่วย\r\n        },\r\n        responsive: true,\r\n      };\r\n\r\n      Plotly.newPlot(\"weekly-absent-trend\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#weekly-absent-trend {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,EAAE,EAAC;AAAqB;;uBAA7BC,mBAAA,CAAoC,OAApCC,UAAoC","ignoreList":[]},"metadata":{},"sour