{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"ResourceAllocationSummary\",\n  props: {\n    data: Object\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const chartData = [{\n        x: this.data.processes,\n        y: this.data.resources,\n        type: \"scatter\",\n        mode: \"lines+markers\",\n        line: {\n          color: \"blue\"\n        }\n      }];\n      const layout = {\n        title: \"Resource Allocation Summary\",\n        height: 300,\n        margin: {\n          l: 50,\n          r: 20,\n          t: 50,\n          b: 50\n        },\n        xaxis: {\n          title: \"Process\",\n          automargin: true\n        },\n        yaxis: {\n          title: \"Resources\",\n          range: [0, 25],\n          // กำหนดช่วงแกน y\n          tick0: 0,\n          dtick: 5 // ให้แสดง tick ทุก 10 หน่วย\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"resource-allocation-summary\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Object","mounted","drawChart","methods","chartData","x","processes","y","resources","type","mode","line","color","layout","title","height","margin","l","r","t","b","xaxis","automargin","yaxis","range","tick0","dtick","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\ResourceAllocationSummary.vue"],"sourcesContent":["<template>\r\n    <div id=\"resource-allocation-summary\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"ResourceAllocationSummary\",\r\n    props: {\r\n      data: Object,\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            x: this.data.processes,\r\n            y: this.data.resources,\r\n            type: \"scatter\",\r\n            mode: \"lines+markers\",\r\n            line: { color: \"blue\" },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n        title: \"Resource Allocation Summary\",\r\n        height: 300,\r\n        margin: { l: 50, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Process\", automargin: true },\r\n        yaxis: {\r\n          title: \"Resources\",\r\n          range: [0, 25], // กำหนดช่วงแกน y\r\n          tick0: 0,\r\n          dtick: 5, // ให้แสดง tick ทุก 10 หน่วย\r\n        },\r\n        responsive: true,\r\n      };\r\n  \r\n        Plotly.newPlot(\"resource-allocation-summary\", chartData, layout);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #resource-allocation-summary {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,2BAA2B;EACjCC,KAAK,EAAE;IACLC,IAAI,EAAEC;EACR,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACPD,SAASA,CAAA,EAAG;MACV,MAAME,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAE,IAAI,CAACN,IAAI,CAACO,SAAS;QACtBC,CAAC,EAAE,IAAI,CAACR,IAAI,CAACS,SAAS;QACtBC,IAAI,EAAE,SAAS;QACfC,IAAI,EAAE,eAAe;QACrBC,IAAI,EAAE;UAAEC,KAAK,EAAE;QAAO;MACxB,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACfC,KAAK,EAAE,6BAA6B;QACpCC,MAAM,EAAE,GAAG;QACXC,MAAM,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE;QAAG,CAAC;QACtCC,KAAK,EAAE;UAAEP,KAAK,EAAE,SAAS;UAAEQ,UAAU,EAAE;QAAK,CAAC;QAC7CC,KAAK,EAAE;UACLT,KAAK,EAAE,WAAW;UAClBU,KAAK,EAAE,CAAC,CAAC,EAAE,EAAE,CAAC;UAAE;UAChBC,KAAK,EAAE,CAAC;UACRC,KAAK,EAAE,CAAC,CAAE;QACZ,CAAC;QACDC,UAAU,EAAE;MACd,CAAC;MAEC/B,MAAM,CAACgC,OAAO,CAAC,6BAA6B,EAAExB,SAAS,EAAES,MAAM,CAAC;IAClE;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}