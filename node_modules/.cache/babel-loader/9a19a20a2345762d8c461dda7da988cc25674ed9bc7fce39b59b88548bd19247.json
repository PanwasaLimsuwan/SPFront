{"ast":null,"code":"export default {\n  props: {\n    skills: {\n      type: Array,\n      required: true,\n      default: () => [{\n        label: 'Material',\n        field: 'material'\n      }, {\n        label: 'Operation',\n        field: 'operation'\n      }, {\n        label: 'Machine: SAB#1',\n        field: 'machine_SAB1'\n      }, {\n        label: 'Machine: SAB#2',\n        field: 'machine_SAB2'\n      }, {\n        label: 'Machine: SAB#3',\n        field: 'machine_SAB3'\n      }, {\n        label: 'Inspection',\n        field: 'inspection'\n      }]\n    },\n    employee: {\n      type: Object,\n      default: null\n    }\n  },\n  methods: {\n    getSkillColor(level) {\n      if (level === 3) return \"green\";\n      if (level === 2) return \"yellow\";\n      if (level === 1) return \"red\";\n      if (level === 0) return \"gray\";\n      return \"transparent\";\n    }\n  }\n};","map":{"version":3,"names":["props","skills","type","Array","required","default","label","field","employee","Object","methods","getSkillColor","level"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"employee\" class=\"employee-section\">\r\n    <h3>{{ employee.firstName }} {{ employee.lastName }}</h3>\r\n    <div v-for=\"(skill, index) in skills\" :key=\"index\">\r\n      <p>{{ skill.label }}: Level {{ employee[skill.field] !== null && employee[skill.field] !== undefined ? employee[skill.field] : \"No Data\" }}</p>\r\n      <div\r\n        class=\"skill-bar\"\r\n        :style=\"{ \r\n          background: `linear-gradient(to right, ${getSkillColor(employee[skill.field])} ${(employee[skill.field] / 3) * 100}%, #ddd ${(employee[skill.field] / 3) * 100}%)`,\r\n          width: '100%'\r\n        }\"\r\n      ></div>\r\n    </div>\r\n  </div>\r\n  <p v-else>กรุณาเลือกพนักงาน</p>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: {\r\n    skills: {\r\n      type: Array,\r\n      required: true,\r\n      default: () => [\r\n        { label: 'Material', field: 'material' },\r\n        { label: 'Operation', field: 'operation' },\r\n        { label: 'Machine: SAB#1', field: 'machine_SAB1' },\r\n        { label: 'Machine: SAB#2', field: 'machine_SAB2' },\r\n        { label: 'Machine: SAB#3', field: 'machine_SAB3' },\r\n        { label: 'Inspection', field: 'inspection' }\r\n      ]\r\n    },\r\n    employee: {\r\n      type: Object,\r\n      default: null,\r\n    },\r\n  },\r\n  methods: {\r\n    getSkillColor(level) {\r\n      if (level === 3) return \"green\";\r\n      if (level === 2) return \"yellow\";\r\n      if (level === 1) return \"red\";\r\n      if (level === 0) return \"gray\";\r\n      return \"transparent\";\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.employee-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.skill-bar {\r\n  height: 20px;\r\n  margin-bottom: 10px;\r\n  border-radius: 5px;\r\n  background-color: gray; /* สีพื้นฐาน */\r\n}\r\n</style>\r\n"],"mappings":"AAkBA,eAAe;EACbA,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE,IAAI;MACdC,OAAO,EAAEA,CAAA,KAAM,CACb;QAAEC,KAAK,EAAE,UAAU;QAAEC,KAAK,EAAE;MAAW,CAAC,EACxC;QAAED,KAAK,EAAE,WAAW;QAAEC,KAAK,EAAE;MAAY,CAAC,EAC1C;QAAED,KAAK,EAAE,gBAAgB;QAAEC,KAAK,EAAE;MAAe,CAAC,EAClD;QAAED,KAAK,EAAE,gBAAgB;QAAEC,KAAK,EAAE;MAAe,CAAC,EAClD;QAAED,KAAK,EAAE,gBAAgB;QAAEC,KAAK,EAAE;MAAe,CAAC,EAClD;QAAED,KAAK,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAa;IAE/C,CAAC;IACDC,QAAQ,EAAE;MACRN,IAAI,EAAEO,MAAM;MACZJ,OAAO,EAAE;IACX;EACF,CAAC;EACDK,OAAO,EAAE;IACPC,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,OAAO;MAC/B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,QAAQ;MAChC,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,KAAK;MAC7B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,MAAM;MAC9B,OAAO,aAAa;IACtB;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}