{"ast":null,"code":"import { openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  id: \"bar-chart\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1);\n}","map":{"version":3,"names":["id","_createElementBlock","_hoisted_1"],"sources":["C:\\JecII\\SPFront\\src\\components\\BarChart.vue"],"sourcesContent":["<template>\r\n  <div id=\"bar-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"BarChart\",\r\n  data() {\r\n    return {\r\n      barChartData: [],\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchBarChartData();\r\n  },\r\n  watch: {\r\n    barChartData: {\r\n      handler() {\r\n        this.drawChart();\r\n      },\r\n      deep: true,\r\n    },\r\n  },\r\n  methods: {\r\n    // ฟังก์ชันดึงข้อมูลจาก API\r\n    async fetchBarChartData() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:5000/api/BarChart\");\r\n        this.barChartData = response.data;\r\n      } catch (error) {\r\n        console.error(\"Error fetching bar chart data:\", error);\r\n      }\r\n    },\r\n    \r\n    // ฟังก์ชันเพื่อวาดกราฟ\r\n    drawChart() {\r\n      const processData = this.barChartData.reduce((acc, item) => {\r\n        if (!acc[item.Process]) {\r\n          acc[item.Process] = {};\r\n        }\r\n        acc[item.Process][item.SkillGroup] = item.EmployeeCount;\r\n        return acc;\r\n      }, {});\r\n\r\n      const processes = Object.keys(processData);\r\n      const skillGroups = [\"Inspection\", \"Machine:SAB#1\", \"Machine:SAB#2\", \"Machine:SAB#3\", \"Material\", \"Operation\"];\r\n      \r\n      const chartData = skillGroups.map((skillGroup) => {\r\n        return {\r\n          x: processes,\r\n          y: processes.map((process) => processData[process][skillGroup] || 0),\r\n          name: skillGroup,\r\n          type: \"bar\",\r\n          text: processes.map((process) => processData[process][skillGroup] || 0),\r\n          textposition: \"auto\",\r\n          marker: { color: \"#76c7c0\" }, // ปรับสีของกราฟ\r\n        };\r\n      });\r\n\r\n      const layout = {\r\n        title: \"Require Support (Process)\",\r\n        barmode: \"stack\",\r\n        height: 400,\r\n        width: 700,\r\n        legend: { orientation: \"v\", x: 1.1, y: 1 },\r\n        xaxis: { title: \"Process\" },\r\n        yaxis: { title: \"Employees\" },\r\n      };\r\n\r\n      Plotly.newPlot(\"bar-chart\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#bar-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,EAAE,EAAC;AAAW;;uBAAnBC,mBAAA,CAA0B,OAA1BC,UAA0B","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}