{"ast":null,"code":"export default {\n  data() {\n    return {\n      employees: [\n      // ตัวอย่างข้อมูลพนักงาน\n      {\n        empID: 1990001,\n        firstName: \"Ponttip\",\n        lastName: \"Chitreechur\",\n        material: 2,\n        operation: 1,\n        machine_SAB1: 0,\n        machine_SAB2: 3,\n        machine_SAB3: 1,\n        inspection: 1\n      }, {\n        empID: 1990002,\n        firstName: \"Somchok\",\n        lastName: \"Vukthong\",\n        material: 1,\n        operation: 2,\n        machine_SAB1: 3,\n        machine_SAB2: 2,\n        machine_SAB3: 0,\n        inspection: 3\n      }],\n      // รายการพนักงาน\n      skills: [\"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"],\n      // รายการทักษะ\n      selectedEmployee: null // พนักงานที่เลือก\n    };\n  },\n  methods: {\n    // ฟังก์ชันในการกำหนดสีตามระดับทักษะ\n    getSkillColor(level) {\n      if (level === 3) return \"green\"; // สีเขียวสำหรับระดับ 3\n      if (level === 2) return \"yellow\"; // สีเหลืองสำหรับระดับ 2\n      if (level === 1) return \"red\"; // สีแดงสำหรับระดับ 1\n      if (level === 0) return \"gray\"; // สีเทาสำหรับระดับ 0\n      return \"transparent\"; // หากไม่มีค่า\n    }\n  }\n};","map":{"version":3,"names":["data","employees","empID","firstName","lastName","material","operation","machine_SAB1","machine_SAB2","machine_SAB3","inspection","skills","selectedEmployee","methods","getSkillColor","level"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"selectedEmployee\" class=\"employee-section\">\r\n    <h3>{{ selectedEmployee.firstName }} {{ selectedEmployee.lastName }}</h3>\r\n    <div v-for=\"skill in skills\" :key=\"skill\">\r\n      <!-- แสดงชื่อทักษะและระดับ -->\r\n      <p>{{ skill }}: Level {{ selectedEmployee[skill] !== undefined ? selectedEmployee[skill] : 'N/A' }}</p>\r\n      <!-- แสดงแถบความก้าวหน้าของทักษะ -->\r\n      <div\r\n        class=\"skill-bar\"\r\n        :style=\"{ \r\n          background: `linear-gradient(to right, ${getSkillColor(selectedEmployee[skill])} ${(selectedEmployee[skill] / 3) * 100}%, #ddd ${(selectedEmployee[skill] / 3) * 100}%)`,\r\n          width: '100%'\r\n        }\"\r\n      ></div>\r\n    </div>\r\n  </div>\r\n  <p v-else>กรุณาเลือกพนักงาน</p>\r\n\r\n  <div>\r\n    <!-- ตัวเลือกพนักงาน -->\r\n    <label for=\"employeeSelect\">เลือกพนักงาน:</label>\r\n    <select v-model=\"selectedEmployee\" id=\"employeeSelect\">\r\n      <option v-for=\"employee in employees\" :key=\"employee.empID\" :value=\"employee\">\r\n        {{ employee.firstName }} {{ employee.lastName }}\r\n      </option>\r\n    </select>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      employees: [\r\n        // ตัวอย่างข้อมูลพนักงาน\r\n        {\r\n          empID: 1990001,\r\n          firstName: \"Ponttip\",\r\n          lastName: \"Chitreechur\",\r\n          material: 2,\r\n          operation: 1,\r\n          machine_SAB1: 0,\r\n          machine_SAB2: 3,\r\n          machine_SAB3: 1,\r\n          inspection: 1,\r\n        },\r\n        {\r\n          empID: 1990002,\r\n          firstName: \"Somchok\",\r\n          lastName: \"Vukthong\",\r\n          material: 1,\r\n          operation: 2,\r\n          machine_SAB1: 3,\r\n          machine_SAB2: 2,\r\n          machine_SAB3: 0,\r\n          inspection: 3,\r\n        },\r\n      ], // รายการพนักงาน\r\n      skills: [\r\n        \"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"\r\n      ], // รายการทักษะ\r\n      selectedEmployee: null, // พนักงานที่เลือก\r\n    };\r\n  },\r\n  methods: {\r\n    // ฟังก์ชันในการกำหนดสีตามระดับทักษะ\r\n    getSkillColor(level) {\r\n      if (level === 3) return \"green\"; // สีเขียวสำหรับระดับ 3\r\n      if (level === 2) return \"yellow\"; // สีเหลืองสำหรับระดับ 2\r\n      if (level === 1) return \"red\"; // สีแดงสำหรับระดับ 1\r\n      if (level === 0) return \"gray\"; // สีเทาสำหรับระดับ 0\r\n      return \"transparent\"; // หากไม่มีค่า\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.employee-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.skill-bar {\r\n  height: 20px;\r\n  margin-bottom: 10px;\r\n  border-radius: 5px;\r\n  background-color: gray; /* ค่าเริ่มต้น */\r\n}\r\n</style>\r\n"],"mappings":"AA8BA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE;MACT;MACA;QACEC,KAAK,EAAE,OAAO;QACdC,SAAS,EAAE,SAAS;QACpBC,QAAQ,EAAE,aAAa;QACvBC,QAAQ,EAAE,CAAC;QACXC,SAAS,EAAE,CAAC;QACZC,YAAY,EAAE,CAAC;QACfC,YAAY,EAAE,CAAC;QACfC,YAAY,EAAE,CAAC;QACfC,UAAU,EAAE;MACd,CAAC,EACD;QACER,KAAK,EAAE,OAAO;QACdC,SAAS,EAAE,SAAS;QACpBC,QAAQ,EAAE,UAAU;QACpBC,QAAQ,EAAE,CAAC;QACXC,SAAS,EAAE,CAAC;QACZC,YAAY,EAAE,CAAC;QACfC,YAAY,EAAE,CAAC;QACfC,YAAY,EAAE,CAAC;QACfC,UAAU,EAAE;MACd,CAAC,CACF;MAAE;MACHC,MAAM,EAAE,CACN,UAAU,EAAE,WAAW,EAAE,cAAc,EAAE,cAAc,EAAE,cAAc,EAAE,YAAW,CACrF;MAAE;MACHC,gBAAgB,EAAE,IAAI,CAAE;IAC1B,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP;IACAC,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,OAAO,EAAE;MACjC,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,QAAQ,EAAE;MAClC,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,KAAK,EAAE;MAC/B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,MAAM,EAAE;MAChC,OAAO,aAAa,EAAE;IACxB;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}