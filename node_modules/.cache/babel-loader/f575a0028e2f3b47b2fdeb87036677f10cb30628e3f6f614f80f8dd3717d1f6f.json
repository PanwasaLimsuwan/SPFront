{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: \"EmployeeRecommendations\",\n  data() {\n    return {\n      employees: [] // สร้างตัวแปร employees เพื่อเก็บข้อมูลจาก API\n    };\n  },\n  mounted() {\n    this.fetchEmployeeData(); // เมื่อ component ถูก mount ให้ดึงข้อมูลจาก API\n  },\n  methods: {\n    // ฟังก์ชันในการดึงข้อมูลจาก API\n    async fetchEmployeeData() {\n      try {\n        const response = await axios.get(\"http://localhost:5000/api/RecEmployee\"); // ชื่อ API จาก Backend\n        console.log(\"Data from API:\", response.data); // ดูข้อมูลที่ได้รับ\n        this.employees = response.data; // เก็บข้อมูลในตัวแปร employees\n      } catch (error) {\n        console.error(\"There was an error fetching the data:\", error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","employees","mounted","fetchEmployeeData","methods","response","get","console","log","error"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeRecommendations.vue"],"sourcesContent":["<template>\r\n  <div class=\"employee-recommendations\">\r\n    <h3>แนะนำพนักงาน</h3>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th>No.</th>\r\n          <th>EmpID</th>\r\n          <th>Firstname</th>\r\n          <th>Lastname</th>\r\n          <th>Work Time</th>\r\n          <th>Skill</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(employee, index) in employees\" :key=\"index\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ employee.employeempID }}</td>\r\n          <td>{{ employee.firstName }}</td>\r\n          <td>{{ employee.lastName }}</td>\r\n          <td>{{ employee.WorkedHours || '-' }}</td> <!-- แสดงค่า Work Time -->\r\n          <td>{{ employee.SkillGroup || '-' }}</td>  <!-- แสดงค่า SkillGroup -->\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: \"EmployeeRecommendations\",\r\n  data() {\r\n    return {\r\n      employees: []  // สร้างตัวแปร employees เพื่อเก็บข้อมูลจาก API\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchEmployeeData();  // เมื่อ component ถูก mount ให้ดึงข้อมูลจาก API\r\n  },\r\n  methods: {\r\n    // ฟังก์ชันในการดึงข้อมูลจาก API\r\n    async fetchEmployeeData() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:5000/api/RecEmployee\");  // ชื่อ API จาก Backend\r\n        console.log(\"Data from API:\", response.data);  // ดูข้อมูลที่ได้รับ\r\n        this.employees = response.data;  // เก็บข้อมูลในตัวแปร employees\r\n      } catch (error) {\r\n        console.error(\"There was an error fetching the data:\", error);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n  .employee-recommendations {\r\n    margin-top: 20px;\r\n  }\r\n\r\n  table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n\r\n  th,\r\n  td {\r\n    padding: 10px;\r\n    text-align: center;\r\n    border: 1px solid #ddd;\r\n  }\r\n\r\n  th {\r\n    background-color: #f4f4f4;\r\n  }\r\n\r\n  .skill-icon {\r\n    width: 30px;\r\n    height: 30px;\r\n    padding: 5px; /* เพิ่มระยะห่างรอบ ๆ ไอคอน */\r\n  }\r\n</style>\r\n"],"mappings":"AA6BA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAC,CAAG;IACjB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,iBAAiB,CAAC,CAAC,EAAG;EAC7B,CAAC;EACDC,OAAO,EAAE;IACP;IACA,MAAMD,iBAAiBA,CAAA,EAAG;MACxB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMP,KAAK,CAACQ,GAAG,CAAC,uCAAuC,CAAC,EAAG;QAC5EC,OAAO,CAACC,GAAG,CAAC,gBAAgB,EAAEH,QAAQ,CAACL,IAAI,CAAC,EAAG;QAC/C,IAAI,CAACC,SAAQ,GAAII,QAAQ,CAACL,IAAI,EAAG;MACnC,EAAE,OAAOS,KAAK,EAAE;QACdF,OAAO,CAACE,KAAK,CAAC,uCAAuC,EAAEA,KAAK,CAAC;MAC/D;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}