{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: \"EmployeeSkillTable\",\n  data() {\n    return {\n      employees: [],\n      // รายการพนักงาน\n      skills: [\"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"],\n      // รายการทักษะ\n      skillLevels: [{\n        label: \"Not Trained (0)\",\n        value: 0\n      }, {\n        label: \"Basic (1)\",\n        value: 1\n      }, {\n        label: \"Medium (2)\",\n        value: 2\n      }, {\n        label: \"Expert (3)\",\n        value: 3\n      }]\n    };\n  },\n  mounted() {\n    this.fetchEmployeeSkills(); // เมื่อ component ถูก mount ให้ดึงข้อมูลจาก API\n  },\n  methods: {\n    async fetchEmployeeSkills() {\n      try {\n        const response = await axios.get(\"http://localhost:5000/api/EmployeeSkill\");\n        this.employees = response.data; // เก็บข้อมูลจาก API\n      } catch (error) {\n        console.error(\"There was an error fetching the data:\", error);\n      }\n    },\n    selectEmployee(employee) {\n      this.$emit('selectEmployee', employee.empID); // Emit empID to parent component\n    },\n    getSkillLevelClass(level) {\n      return `level-${level}`; // Dynamically assign class based on skill level\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","employees","skills","skillLevels","label","value","mounted","fetchEmployeeSkills","methods","response","get","error","console","selectEmployee","employee","$emit","empID","getSkillLevelClass","level"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n  <div class=\"employee-skill-table\">\r\n    <h3>Employee Skill</h3>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th>No.</th>\r\n          <th>EmpID</th>\r\n          <th>Firstname</th>\r\n          <th>Lastname</th>\r\n          <th v-for=\"skill in skills\" :key=\"skill\">{{ skill }}</th>\r\n          <th>Select</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(employee, index) in employees\" :key=\"employee.empID\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ employee.empID }}</td>\r\n          <td>{{ employee.firstName }}</td>\r\n          <td>{{ employee.lastName }}</td>\r\n          <td\r\n            v-for=\"skill in skills\"\r\n            :key=\"skill\"\r\n            :class=\"getSkillLevelClass(employee[skill])\"\r\n          >\r\n            {{ employee[skill] }} <!-- Mapping the data dynamically based on 'skills' -->\r\n          </td>\r\n          <td>\r\n            <button @click=\"selectEmployee(employee)\">\r\n              <img src=\"skill.png\" alt=\"Skill\" class=\"skill-icon\" />\r\n            </button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n    <div class=\"legend\">\r\n      <span v-for=\"(level, index) in skillLevels\" :key=\"index\">\r\n        <span :class=\"'legend-dot level-' + level.value\"></span> {{ level.label }}\r\n      </span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: \"EmployeeSkillTable\",\r\n  data() {\r\n    return {\r\n      employees: [],  // รายการพนักงาน\r\n      skills: [\r\n        \"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"\r\n      ],  // รายการทักษะ\r\n      skillLevels: [\r\n        { label: \"Not Trained (0)\", value: 0 },\r\n        { label: \"Basic (1)\", value: 1 },\r\n        { label: \"Medium (2)\", value: 2 },\r\n        { label: \"Expert (3)\", value: 3 },\r\n      ],\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchEmployeeSkills();  // เมื่อ component ถูก mount ให้ดึงข้อมูลจาก API\r\n  },\r\n  methods: {\r\n    async fetchEmployeeSkills() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:5000/api/EmployeeSkill\");\r\n        this.employees = response.data;  // เก็บข้อมูลจาก API\r\n      } catch (error) {\r\n        console.error(\"There was an error fetching the data:\", error);\r\n      }\r\n    },\r\n    selectEmployee(employee) {\r\n      this.$emit('selectEmployee', employee.empID);  // Emit empID to parent component\r\n    },\r\n    getSkillLevelClass(level) {\r\n      return `level-${level}`;  // Dynamically assign class based on skill level\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.employee-skill-table {\r\n  margin-top: 20px;\r\n}\r\n\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\nth,\r\ntd {\r\n  padding: 10px;\r\n  text-align: center;\r\n  border: 1px solid #ddd;\r\n}\r\n\r\nth {\r\n  background-color: #f4f4f4;\r\n}\r\n\r\n.legend {\r\n  margin-top: 10px;\r\n  display: flex;\r\n  justify-content: space-around;\r\n}\r\n\r\n.legend-dot {\r\n  width: 15px;\r\n  height: 15px;\r\n  display: inline-block;\r\n  border-radius: 50%;\r\n  margin-right: 5px;\r\n}\r\n\r\n.level-0 {\r\n  background: #ddd;\r\n}\r\n\r\n.level-1 {\r\n  background: red;\r\n}\r\n\r\n.level-2 {\r\n  background: yellow;\r\n}\r\n\r\n.level-3 {\r\n  background: green;\r\n}\r\n\r\nbutton {\r\n  background-color: transparent;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.skill-icon {\r\n  width: 30px;\r\n  height: 30px;\r\n}\r\n</style>\r\n"],"mappings":"AA4CA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MAAG;MAChBC,MAAM,EAAE,CACN,UAAU,EAAE,WAAW,EAAE,cAAc,EAAE,cAAc,EAAE,cAAc,EAAE,YAAW,CACrF;MAAG;MACJC,WAAW,EAAE,CACX;QAAEC,KAAK,EAAE,iBAAiB;QAAEC,KAAK,EAAE;MAAE,CAAC,EACtC;QAAED,KAAK,EAAE,WAAW;QAAEC,KAAK,EAAE;MAAE,CAAC,EAChC;QAAED,KAAK,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAE,CAAC,EACjC;QAAED,KAAK,EAAE,YAAY;QAAEC,KAAK,EAAE;MAAE,CAAC;IAErC,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,mBAAmB,CAAC,CAAC,EAAG;EAC/B,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,mBAAmBA,CAAA,EAAG;MAC1B,IAAI;QACF,MAAME,QAAO,GAAI,MAAMX,KAAK,CAACY,GAAG,CAAC,yCAAyC,CAAC;QAC3E,IAAI,CAACT,SAAQ,GAAIQ,QAAQ,CAACT,IAAI,EAAG;MACnC,EAAE,OAAOW,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,uCAAuC,EAAEA,KAAK,CAAC;MAC/D;IACF,CAAC;IACDE,cAAcA,CAACC,QAAQ,EAAE;MACvB,IAAI,CAACC,KAAK,CAAC,gBAAgB,EAAED,QAAQ,CAACE,KAAK,CAAC,EAAG;IACjD,CAAC;IACDC,kBAAkBA,CAACC,KAAK,EAAE;MACxB,OAAO,SAASA,KAAK,EAAE,EAAG;IAC5B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}