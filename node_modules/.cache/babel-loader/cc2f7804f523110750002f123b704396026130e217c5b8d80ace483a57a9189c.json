{"ast":null,"code":"import { openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  id: \"skill-level-pie-chart\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1);\n}","map":{"version":3,"names":["id","_createElementBlock","_hoisted_1"],"sources":["C:\\JecII\\SPFront\\src\\components\\SkillLevelPieChart.vue"],"sourcesContent":["<template>\r\n  <div id=\"skill-level-pie-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"SkillLevelPieChart\",\r\n  data() {\r\n    return {\r\n      skillData: null, // ข้อมูลที่จะใช้สำหรับกราฟ\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchSkillData();  // เรียกใช้ฟังก์ชันดึงข้อมูล\r\n  },\r\n  methods: {\r\n    // ฟังก์ชันดึงข้อมูลจาก API\r\n    async fetchSkillData() {\r\n      try {\r\n        const response = await this.$axios.get(\"http://localhost:5000/api/SkillLevelPieChart\");\r\n        const skillData = response.data;\r\n        \r\n        // เตรียมข้อมูลให้กับกราฟ\r\n        const values = skillData.map(item => item.SkillCount);\r\n        const labels = skillData.map(item => item.SkillGroup);\r\n        \r\n        // เรียกใช้งานฟังก์ชันเพื่อวาดกราฟ\r\n        this.drawChart(values, labels);\r\n      } catch (error) {\r\n        console.error(\"Error fetching skill level data:\", error);\r\n      }\r\n    },\r\n\r\n    // ฟังก์ชันวาดกราฟ\r\n    drawChart(values, labels) {\r\n      const chartData = [\r\n        {\r\n          values: values,  // จำนวนทักษะที่นับได้จากฐานข้อมูล\r\n          labels: labels,  // SkillGroup เช่น Inspection, Machine, Operation\r\n          type: \"pie\",\r\n          marker: {\r\n            colors: [\"gray\", \"red\", \"yellow\", \"green\"], // สีสำหรับแต่ละระดับ\r\n          },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Skill Level Distribution\",  // ชื่อกราฟ\r\n        height: 450,\r\n        width: 450,\r\n      };\r\n\r\n      // วาดกราฟ\r\n      Plotly.newPlot(\"skill-level-pie-chart\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#skill-level-pie-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,EAAE,EAAC;AAAuB;;uBAA/BC,mBAAA,CAAsC,OAAtCC,UAAsC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}