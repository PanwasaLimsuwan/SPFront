{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"WeeklyOvertime\",\n  props: {\n    data: Object\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const {\n        processes,\n        overtime\n      } = this.data;\n      const chartData = [{\n        x: processes,\n        y: overtime,\n        type: \"bar\",\n        marker: {\n          color: \"purple\"\n        }\n      }];\n      const layout = {\n        title: \"Weekly Overtime (OT)\",\n        height: 300,\n        xaxis: {\n          title: \"Process\"\n        },\n        yaxis: {\n          title: \"Hours\",\n          range: [0, 40]\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"overtime-chart\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Object","mounted","drawChart","methods","processes","overtime","chartData","x","y","type","marker","color","layout","title","height","xaxis","yaxis","range","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\WeeklyOvertime.vue"],"sourcesContent":["<template>\r\n    <div id=\"overtime-chart\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"WeeklyOvertime\",\r\n    props: {\r\n      data: Object,\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const { processes, overtime } = this.data;\r\n  \r\n        const chartData = [\r\n          {\r\n            x: processes,\r\n            y: overtime,\r\n            type: \"bar\",\r\n            marker: { color: \"purple\" },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n          title: \"Weekly Overtime (OT)\",\r\n          height: 300,\r\n          xaxis: { title: \"Process\" },\r\n          yaxis: { title: \"Hours\", range: [0, 40] },\r\n          responsive: true,\r\n        };\r\n  \r\n