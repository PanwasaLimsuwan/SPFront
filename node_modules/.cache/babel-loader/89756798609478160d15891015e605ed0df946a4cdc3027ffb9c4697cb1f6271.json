{"ast":null,"code":"import { openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  id: \"resource-allocation-summary\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1);\n}","map":{"version":3,"names":["id","_createElementBlock","_hoisted_1"],"sources":["C:\\JecII\\SPFront\\src\\components\\ResourceAllocationSummary.vue"],"sourcesContent":["<template>\r\n    <div id=\"resource-allocation-summary\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"ResourceAllocationSummary\",\r\n    props: {\r\n      data: Object,\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            x: this.data.processes,\r\n            y: this.data.resources,\r\n            type: \"scatter\",\r\n            mode: \"lines+markers\",\r\n            line: { color: \"blue\" },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n        title: \"Resource Allocation Summary\",\r\n        height: 300,\r\n        margin: { l: 50, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Process\", automargin: true },\r\n        yaxis: {\r\n          title: \"Resources\",\r\n          range: [0, 25], // กำหนดช่วงแกน y\r\n          tick0: 0,\r\n          dtick: 5, // ให้แสดง tick ทุก 10 หน่วย\r\n        },\r\n        responsive: true,\r\n      };\r\n  \r\n        Plotly.newPlot(\"resource-allocation-summary\", chartData, layout);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #resource-allocation-summary {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":";;EACSA,EAAE,EAAC;AAA6B;;uBAArCC,mBAAA,CAA4C,OAA5CC,UAA4C","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}