{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"HeadcountPlan\",\n  props: {\n    data: Object\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const {\n        processes,\n        headcount,\n        plan\n      } = this.data;\n      const chartData = [{\n        x: processes,\n        y: headcount,\n        type: \"bar\",\n        name: \"Headcount\",\n        marker: {\n          color: \"blue\"\n        }\n      }, {\n        x: processes,\n        y: plan,\n        type: \"bar\",\n        name: \"Plan\",\n        marker: {\n          color: \"red\"\n        }\n      }];\n      const layout = {\n        title: \"Headcount vs Plan\",\n        barmode: \"group\",\n        height: 300,\n        xaxis: {\n          title: \"Process\"\n        },\n        yaxis: {\n          title: \"Count\",\n          range: [0, 250]\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"headcount-chart\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Object","mounted","drawChart","methods","processes","headcount","plan","chartData","x","y","type","marker","color","layout","title","barmode","height","xaxis","yaxis","range","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\HeadcountPlan.vue"],"sourcesContent":["<template>\r\n    <div id=\"headcount-chart\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"HeadcountPlan\",\r\n    props: {\r\n      data: Object,\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const { processes, headcount, plan } = this.data;\r\n  \r\n        const chartData = [\r\n          {\r\n            x: processes,\r\n            y: headcount,\r\n            type: \"bar\",\r\n            name: \"Headcount\",\r\n            marker: { color: \"blue\" },\r\n