{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"ShiftRequireSupport\",\n  props: {\n    data: Object\n  },\n  mounted() {\n    this.drawChart();\n  },\n  watch: {\n    data() {\n      this.drawChart();\n    }\n  },\n  methods: {\n    drawChart() {\n      if (!this.data) return;\n      const {\n        processes,\n        dayShift,\n        nightShift\n      } = this.data;\n      const chartData = [{\n        x: processes,\n        y: dayShift,\n        type: \"bar\",\n        name: \"Shift : Day\",\n        marker: {\n          color: \"blue\"\n        }\n      }, {\n        x: processes,\n        y: nightShift,\n        type: \"bar\",\n        name: \"Shift : Night\",\n        marker: {\n          color: \"red\"\n        }\n      }];\n      const layout = {\n        title: \"Weekly Shift Require Support\",\n        barmode: \"group\",\n        height: 300,\n        xaxis: {\n          title: \"Process\"\n        },\n        yaxis: {\n          title: \"Count\",\n          range: [0, 15]\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"shift-support-chart\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Object","mounted","drawChart","watch","methods","processes","dayShift","nightShift","chartData","x","y","type","marker","color","layout","title","barmode","height","xaxis","yaxis","range","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\ShiftRequireSupport.vue"],"sourcesContent":["<template>\r\n  <div id=\"shift-support-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"ShiftRequireSupport\",\r\n  props: {\r\n    data: Object,\r\n  },\r\n  mounted() {\r\n    this.drawChart();\r\n  },\r\n  watch: {\r\n    data() {\r\n      this.drawChart();\r\n    },\r\n  },\r\n  methods: {\r\n    drawChart() {\r\n      if (!this.data) return;\r\n\r\n      const { processes, dayShift, nightShift } = this.data;\r\n\r\n      const chartData = [\r\n        {\r\n          x: processes,\r\n          y: dayShift,\r\n          type: \"bar\",\r\n          name: \"Shift : Day\",\r\n          marker: { color: \"blue\" },\r\n        },\r\n        {\r\n          x: processes,\r\n          y: nightShift,\r\n          type: \"bar\",\r\n          name: \"Shift : Night\",\r\n          marker: { color: \"red\" },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Weekly Shift Require Support\",\r\n        barmode: \"group\",\r\n        height: 300,\r\n        xaxis: { title: \"Process\" },\r\n        yaxis: { title: \"Count\", range: [0, 15] },\r\n        responsive: true,\r\n      };\r\n\r\n      Plotly.newPlot(\"shift-support-chart\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAKA,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,qBAAqB;EAC3BC,KAAK,EAAE;IACLC,IAAI,EAAEC;EACR,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,KAAK,EAAE;IACLJ,IAAIA,CAAA,EAAG;MACL,IAAI,CAACG,SAAS,CAAC,CAAC;IAClB;EACF,CAAC;EACDE,OAAO,EAAE;IACPF,SAASA,CAAA,EAAG;MACV,IAAI,CAAC,IAAI,CAACH,IAAI,EAAE;MAEhB,MAAM;QAAEM,SAAS;QAAEC,QAAQ;QAAEC;MAAW,IAAI,IAAI,CAACR,IAAI;MAErD,MAAMS,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAEJ,SAAS;QACZK,CAAC,EAAEJ,QAAQ;QACXK,IAAI,EAAE,KAAK;QACXd,IAAI,EAAE,aAAa;QACnBe,MAAM,EAAE;UAAEC,KAAK,EAAE;QAAO;MAC1B,CAAC,EACD;QACEJ,CAAC,EAAEJ,SAAS;QACZK,CAAC,EAAEH,UAAU;QACbI,IAAI,EAAE,KAAK;QACXd,IAAI,EAAE,eAAe;QACrBe,MAAM,EAAE;UAAEC,KAAK,EAAE;QAAM;MACzB,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACbC,KAAK,EAAE,8BAA8B;QACrCC,OAAO,EAAE,OAAO;QAChBC,MAAM,EAAE,GAAG;QACXC,KAAK,EAAE;UAAEH,KAAK,EAAE;QAAU,CAAC;QAC3BI,KAAK,EAAE;UAAEJ,KAAK,EAAE,OAAO;UAAEK,KAAK,EAAE,CAAC,CAAC,EAAE,EAAE;QAAE,CAAC;QACzCC,UAAU,EAAE;MACd,CAAC;MAEDzB,MAAM,CAAC0B,OAAO,CAAC,qBAAqB,EAAEd,SAAS,EAAEM,MAAM,CAAC;IAC1D;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}