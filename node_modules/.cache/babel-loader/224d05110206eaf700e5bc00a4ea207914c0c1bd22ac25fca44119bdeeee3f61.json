{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport Plotly from \"plotly.js\";\nimport axios from \"axios\"; // ใช้ axios ในการดึงข้อมูล\n\nexport default {\n  name: \"WeeklyAbsentTrend\",\n  data() {\n    return {\n      data: {\n        Week: [],\n        // ใส่ข้อมูล WeekNumber\n        absences: [] // ใส่ข้อมูล Absences\n      }\n    };\n  },\n  mounted() {\n    this.fetchData();\n  },\n  methods: {\n    async fetchData() {\n      try {\n        // ดึงข้อมูลจาก API\n        const response = await axios.get(\"http://localhost:5000/api/WeeklyAbsent\");\n        const dataFromApi = response.data;\n\n        // แยกข้อมูลเป็น days (WeekNumber) และ absences\n        this.data.Week = dataFromApi.map(item => item.WeekNumber);\n        this.data.absences = dataFromApi.map(item => item.absences);\n\n        // วาดกราฟหลังจากข้อมูลถูกดึง\n        this.drawChart();\n      } catch (error) {\n        console.error(\"There was an error fetching the data:\", error);\n      }\n    },\n    drawChart() {\n      const chartData = [{\n        x: this.data.days,\n        y: this.data.absences,\n        type: \"scatter\",\n        mode: \"lines+markers\",\n        line: {\n          color: \"red\"\n        }\n      }];\n      const layout = {\n        title: \"Weekly Absent Trend\",\n        height: 300,\n        margin: {\n          l: 50,\n          r: 20,\n          t: 50,\n          b: 50\n        },\n        xaxis: {\n          title: \"Week Number\",\n          automargin: true\n        },\n        yaxis: {\n          title: \"Absences\",\n          range: [0, 50],\n          // กำหนดช่วงแกน y\n          tick0: 0,\n          dtick: 10 // ให้แสดง tick ทุก 10 หน่วย\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"weekly-absent-trend\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","axios","name","data","Week","absences","mounted","fetchData","methods","response","get","dataFromApi","map","item","WeekNumber","drawChart","error","console","chartData","x","days","y","type","mode","line","color","layout","title","height","margin","l","r","t","b","xaxis","automargin","yaxis","range","tick0","dtick","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\WeeklyAbsentTrend.vue"],"sourcesContent":["<template>\r\n  <div id=\"weekly-absent-trend\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\nimport axios from \"axios\"; // ใช้ axios ในการดึงข้อมูล\r\n\r\nexport default {\r\n  name: \"WeeklyAbsentTrend\",\r\n  data() {\r\n    return {\r\n      data: {\r\n        Week: [],  // ใส่ข้อมูล WeekNumber\r\n        absences: [],  // ใส่ข้อมูล Absences\r\n      },\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchData();\r\n  },\r\n  methods: {\r\n    async fetchData() {\r\n      try {\r\n        // ดึงข้อมูลจาก API\r\n        const response = await axios.get(\"http://localhost:5000/api/WeeklyAbsent\");\r\n        const dataFromApi = response.data;\r\n\r\n        // แยกข้อมูลเป็น days (WeekNumber) และ absences\r\n        this.data.Week = dataFromApi.map(item => item.WeekNumber);\r\n        this.data.absences = dataFromApi.map(item => item.absences);\r\n\r\n        // วาดกราฟหลังจากข้อมูลถูกดึง\r\n        this.drawChart();\r\n      } catch (error) {\r\n        console.error(\"There was an error fetching the data:\", error);\r\n      }\r\n    },\r\n\r\n    drawChart() {\r\n      const chartData = [\r\n        {\r\n          x: this.data.days,\r\n          y: this.data.absences,\r\n          type: \"scatter\",\r\n          mode: \"lines+markers\",\r\n          line: { color: \"red\" },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Weekly Absent Trend\",\r\n        height: 300,\r\n        margin: { l: 50, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Week Number\", automargin: true },\r\n        yaxis: {\r\n          title: \"Absences\",\r\n          range: [0, 50], // กำหนดช่วงแกน y\r\n          tick0: 0,\r\n          dtick: 10, // ให้แสดง tick ทุก 10 หน่วย\r\n        },\r\n        responsive: true,\r\n      };\r\n\r\n      Plotly.newPlot(\"weekly-absent-trend\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#weekly-absent-trend {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";AAKA,OAAOA,MAAK,MAAO,WAAW;AAC9B,OAAOC,KAAI,MAAO,OAAO,EAAE;;AAE3B,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLA,IAAI,EAAE;QACJC,IAAI,EAAE,EAAE;QAAG;QACXC,QAAQ,EAAE,EAAE,CAAG;MACjB;IACF,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACP,MAAMD,SAASA,CAAA,EAAG;MAChB,IAAI;QACF;QACA,MAAME,QAAO,GAAI,MAAMR,KAAK,CAACS,GAAG,CAAC,wCAAwC,CAAC;QAC1E,MAAMC,WAAU,GAAIF,QAAQ,CAACN,IAAI;;QAEjC;QACA,IAAI,CAACA,IAAI,CAACC,IAAG,GAAIO,WAAW,CAACC,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACC,UAAU,CAAC;QACzD,IAAI,CAACX,IAAI,CAACE,QAAO,GAAIM,WAAW,CAACC,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACR,QAAQ,CAAC;;QAE3D;QACA,IAAI,CAACU,SAAS,CAAC,CAAC;MAClB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,uCAAuC,EAAEA,KAAK,CAAC;MAC/D;IACF,CAAC;IAEDD,SAASA,CAAA,EAAG;MACV,MAAMG,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAE,IAAI,CAAChB,IAAI,CAACiB,IAAI;QACjBC,CAAC,EAAE,IAAI,CAAClB,IAAI,CAACE,QAAQ;QACrBiB,IAAI,EAAE,SAAS;QACfC,IAAI,EAAE,eAAe;QACrBC,IAAI,EAAE;UAAEC,KAAK,EAAE;QAAM;MACvB,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACbC,KAAK,EAAE,qBAAqB;QAC5BC,MAAM,EAAE,GAAG;QACXC,MAAM,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE;QAAG,CAAC;QACtCC,KAAK,EAAE;UAAEP,KAAK,EAAE,aAAa;UAAEQ,UAAU,EAAE;QAAK,CAAC;QACjDC,KAAK,EAAE;UACLT,KAAK,EAAE,UAAU;UACjBU,KAAK,EAAE,CAAC,CAAC,EAAE,EAAE,CAAC;UAAE;UAChBC,KAAK,EAAE,CAAC;UACRC,KAAK,EAAE,EAAE,CAAE;QACb,CAAC;QACDC,UAAU,EAAE;MACd,CAAC;MAEDxC,MAAM,CAACyC,OAAO,CAAC,qBAAqB,EAAEvB,SAAS,EAAEQ,MAAM,CAAC;IAC1D;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}