{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport Plotly from \"plotly.js\";\nexport default {\n  name: \"WeeklyAbsentTrend\",\n  props: {\n    data: Object // รับข้อมูลจาก API ที่ส่งมา\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const chartData = [{\n        x: this.data.map(item => item.Absences),\n        // ใช้ WeekNumber เป็นค่าแกน x\n        y: this.data.map(item => item.WeekNumber),\n        // ใช้ Absences เป็นค่าแกน y\n        type: \"scatter\",\n        mode: \"lines+markers\",\n        line: {\n          color: \"red\"\n        }\n      }];\n      const layout = {\n        title: \"Weekly Absent Trend\",\n        height: 300,\n        margin: {\n          l: 50,\n          r: 20,\n          t: 50,\n          b: 50\n        },\n        xaxis: {\n          title: \"Week Number\",\n          automargin: true\n        },\n        yaxis: {\n          title: \"Absences\",\n          range: [0, Math.max(...this.data.map(item => item.Absences)) + 5],\n          // กำหนดช่วงของแกน y ให้เพิ่มจากข้อมูลสูงสุด\n          tick0: 0,\n          dtick: 1 // ให้แสดง tick ทุก 1 หน่วย\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"weekly-absent-trend\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Object","mounted","drawChart","methods","chartData","x","map","item","Absences","y","WeekNumber","type","mode","line","color","layout","title","height","margin","l","r","t","b","xaxis","automargin","yaxis","range","Math","max","tick0","dtick","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\WeeklyAbsentTrend.vue"],"sourcesContent":["<template>\r\n  <div id=\"weekly-absent-trend\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"WeeklyAbsentTrend\",\r\n  props: {\r\n    data: Object, // รับข้อมูลจาก API ที่ส่งมา\r\n  },\r\n  mounted() {\r\n    this.drawChart();\r\n  },\r\n  methods: {\r\n    drawChart() {\r\n      const chartData = [\r\n        {\r\n          x: this.data.map(item => item.Absences), // ใช้ WeekNumber เป็นค่าแกน x\r\n          y: this.data.map(item => item.WeekNumber),   // ใช้ Absences เป็นค่าแกน y\r\n          type: \"scatter\",\r\n          mode: \"lines+markers\",\r\n          line: { color: \"red\" },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Weekly Absent Trend\",\r\n        height: 300,\r\n        margin: { l: 50, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Week Number\", automargin: true },\r\n        yaxis: {\r\n          title: \"Absences\",\r\n          range: [0, Math.max(...this.data.map(item => item.Absences)) + 5], // กำหนดช่วงของแกน y ให้เพิ่มจากข้อมูลสูงสุด\r\n          tick0: 0,\r\n          dtick: 1, // ให้แสดง tick ทุก 1 หน่วย\r\n        },\r\n        responsive: true,\r\n      };\r\n\r\n      Plotly.newPlot(\"weekly-absent-trend\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#weekly-absent-trend {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";AAKA,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,mBAAmB;EACzBC,KAAK,EAAE;IACLC,IAAI,EAAEC,MAAM,CAAE;EAChB,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACPD,SAASA,CAAA,EAAG;MACV,MAAME,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAE,IAAI,CAACN,IAAI,CAACO,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACC,QAAQ,CAAC;QAAE;QACzCC,CAAC,EAAE,IAAI,CAACV,IAAI,CAACO,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACG,UAAU,CAAC;QAAI;QAC7CC,IAAI,EAAE,SAAS;QACfC,IAAI,EAAE,eAAe;QACrBC,IAAI,EAAE;UAAEC,KAAK,EAAE;QAAM;MACvB,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACbC,KAAK,EAAE,qBAAqB;QAC5BC,MAAM,EAAE,GAAG;QACXC,MAAM,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE;QAAG,CAAC;QACtCC,KAAK,EAAE;UAAEP,KAAK,EAAE,aAAa;UAAEQ,UAAU,EAAE;QAAK,CAAC;QACjDC,KAAK,EAAE;UACLT,KAAK,EAAE,UAAU;UACjBU,KAAK,EAAE,CAAC,CAAC,EAAEC,IAAI,CAACC,GAAG,CAAC,