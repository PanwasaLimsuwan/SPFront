{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"MonthlyAbsentTrend\",\n  props: {\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    this.drawChart();\n  },\n  watch: {\n    data: {\n      deep: true,\n      handler() {\n        this.drawChart();\n      }\n    }\n  },\n  methods: {\n    drawChart() {\n      const {\n        months,\n        absentTrend\n      } = this.data;\n      const chartData = [{\n        x: months,\n        y: absentTrend,\n        type: \"scatter\",\n        mode: \"lines+markers\",\n        marker: {\n          color: \"orange\",\n          size: 8\n        },\n        line: {\n          color: \"orange\"\n        }\n      }];\n      const layout = {\n        title: \"Monthly Absent Trend\",\n        xaxis: {\n          title: \"Months\"\n        },\n        yaxis: {\n          title: \"Absent (%)\"\n        },\n        height: 400,\n        //   width: 800,\n        paper_bgcolor: \"rgba(0,0,0,0)\",\n        //   plot_bgcolor: \"rgba(0,0,0,0)\",\n        responsive: true\n      };\n      Plotly.newPlot(\"monthly-absent-trend\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","mounted","drawChart","watch","deep","handler","methods","months","absentTrend","chartData","x","y","mode","marker","color","size","line","layout","title","xaxis","yaxis","height","paper_bgcolor","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\MonthlyAbsentTrend.vue"],"sourcesContent":["<template>\r\n    <div id=\"monthly-absent-trend\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"MonthlyAbsentTrend\",\r\n    props: {\r\n      data: {\r\n        type: Object,\r\n        required: true,\r\n      },\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    watch: {\r\n      data: {\r\n        deep: true,\r\n        handler() {\r\n          this.drawChart();\r\n        },\r\n      },\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const { months, absentTrend } = this.data;\r\n  \r\n        const chartData = [\r\n          {\r\n            x: months,\r\n            y: absentTrend,\r\n            type: \"scatter\",\r\n            mode: \"lines+markers\",\r\n            marker: {\r\n              color: \"orange\",\r\n              size: 8,\r\n            },\r\n            line: {\r\n              color: \"orange\",\r\n            },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n          title: \"Monthly Absent Trend\",\r\n          xaxis: { title: \"Months\" },\r\n          yaxis: { title: \"Absent (%)\" },\r\n          height: 400,\r\n        //   width: 800,\r\n          paper_bgcolor: \"rgba(0,0,0,0)\",\r\n        //   plot_bgcolor: \"rgba(0,0,0,0)\",\r\n          responsive: true,\r\n        };\r\n  \r\n        Plotly.newPlot(\"monthly-absent-trend\", chartData, layout);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #monthly-absent-trend {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,KAAK,EAAE;IACLN,IAAI,EAAE;MACJO,IAAI,EAAE,IAAI;MACVC,OAAOA,CAAA,EAAG;QACR,IAAI,CAACH,SAAS,CAAC,CAAC;MAClB;IACF;EACF,CAAC;EACDI,OAAO,EAAE;IACPJ,SAASA,CAAA,EAAG;MACV,MAAM;QAAEK,MAAM;QAAEC;MAAY,IAAI,IAAI,CAACX,IAAI;MAEzC,MAAMY,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAEH,MAAM;QACTI,CAAC,EAAEH,WAAW;QACdV,IAAI,EAAE,SAAS;QACfc,IAAI,EAAE,eAAe;QACrBC,MAAM,EAAE;UACNC,KAAK,EAAE,QAAQ;UACfC,IAAI,EAAE;QACR,CAAC;QACDC,IAAI,EAAE;UACJF,KAAK,EAAE;QACT;MACF,CAAC,CACF;MAED,MAAMG,MAAK,GAAI;QACbC,KAAK,EAAE,sBAAsB;QAC7BC,KAAK,EAAE;UAAED,KAAK,EAAE;QAAS,CAAC;QAC1BE,KAAK,EAAE;UAAEF,KAAK,EAAE;QAAa,CAAC;QAC9BG,MAA