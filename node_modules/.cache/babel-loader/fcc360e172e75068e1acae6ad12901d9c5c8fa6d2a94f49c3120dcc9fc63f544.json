{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"MonthlyEmployeeExitRate\",\n  props: {\n    data: {\n      type: Object,\n      required: true,\n      default: () => ({\n        months: [],\n        exitRate: []\n      })\n    }\n  },\n  mounted() {\n    this.drawChart();\n  },\n  watch: {\n    data: {\n      deep: true,\n      handler() {\n        this.drawChart();\n      }\n    }\n  },\n  methods: {\n    drawChart() {\n      const {\n        months,\n        exitRate\n      } = this.data;\n      const chartData = [{\n        x: months,\n        y: exitRate,\n        type: \"scatter\",\n        mode: \"lines+markers\",\n        marker: {\n          color: \"red\",\n          size: 8\n        },\n        line: {\n          color: \"red\"\n        }\n      }];\n      const layout = {\n        title: \"Monthly Employee Exit Rate\",\n        xaxis: {\n          title: \"Months\"\n        },\n        yaxis: {\n          title: \"Exit Rate (%)\"\n        },\n        height: 400,\n        // width: 800,\n        paper_bgcolor: \"rgba(0,0,0,0)\",\n        responsive: true\n      };\n      Plotly.newPlot(\"monthly-employee-exit-rate\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","default","months","exitRate","mounted","drawChart","watch","deep","handler","methods","chartData","x","y","mode","marker","color","size","line","layout","title","xaxis","yaxis","height","paper_bgcolor","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\MonthlyEmployeeExitRate.vue"],"sourcesContent":["<template>\r\n  <div id=\"monthly-employee-exit-rate\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"MonthlyEmployeeExitRate\",\r\n  props: {\r\n    data: {\r\n      type: Object,\r\n      required: true,\r\n      default: () => ({\r\n        months: [],\r\n        exitRate: [],\r\n      }),\r\n    },\r\n  },\r\n  mounted() {\r\n    this.drawChart();\r\n  },\r\n  watch: {\r\n    data: {\r\n      deep: true,\r\n      handler() {\r\n        this.drawChart();\r\n      },\r\n    },\r\n  },\r\n  methods: {\r\n    drawChart() {\r\n      const { months, exitRate } = this.data;\r\n\r\n      const chartData = [\r\n        {\r\n          x: months,\r\n          y: exitRate,\r\n          type: \"scatter\",\r\n          mode: \"lines+markers\",\r\n          marker: {\r\n            color: \"red\",\r\n            size: 8,\r\n          },\r\n          line: {\r\n            color: \"red\",\r\n          },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Monthly Employee Exit Rate\",\r\n        xaxis: { title: \"Months\" },\r\n        yaxis: { title: \"Exit Rate (%)\" },\r\n        height: 400,\r\n        // width: 800,\r\n        paper_bgcolor: \"rgba(0,0,0,0)\",\r\n        responsive: true,\r\n      };\r\n\r\n      Plotly.newPlot(\"monthly-employee-exit-rate\", chartData, layout);\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#monthly-employee-exit-rate {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":"AAKA,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,yBAAyB;EAC/BC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE,IAAI;MACdC,OAAO,EAAEA,CAAA,MAAO;QACdC,MAAM,EAAE,EAAE;QACVC,QAAQ,EAAE;MACZ,CAAC;IACH;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,KAAK,EAAE;IACLT,IAAI,EAAE;MACJU,IAAI,EAAE,IAAI;MACVC,OAAOA,CAAA,EAAG;QACR,IAAI,CAACH,SAAS,CAAC,CAAC;MAClB;IACF;EACF,CAAC;EACDI,OAAO,EAAE;IACPJ,SAASA,CAAA,EAAG;MACV,MAAM;QAAEH,MAAM;QAAEC;MAAS,IAAI,IAAI,CAACN,IAAI;MAEtC,MAAMa,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAET,MAAM;QACTU,CAAC,EAAET,QAAQ;QACXL,IAAI,EAAE,SAAS;QACfe,IAAI,EAAE,eAAe;QACrBC,MAAM,EAAE;UACNC,KAAK,EAAE,KAAK;UACZC,IAAI,EAAE;QACR,CAAC;QACDC,IAAI,EAAE;UACJF,KAAK,EAAE;QACT;MACF,CAAC,CACF;MAED,MAAMG,MAAK,GAAI;QACbC,KAAK,EAAE,4BAA4B;QACnCC,KAAK,EAAE;UAAED,KAAK,EAAE;QAAS,CAAC;Q