{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport Plotly from \"plotly.js\";\nexport default {\n  name: \"WorkedTimeChart\",\n  props: {\n    data: Array\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const chartData = [{\n        x: this.data.map(emp => emp.hours),\n        y: this.data.map(emp => `${emp.firstname} ${emp.lastname}`),\n        type: \"bar\",\n        orientation: \"h\",\n        marker: {\n          color: this.data.map(emp => emp.hours > 60 ? \"red\" : \"yellow\")\n        }\n      }];\n      const layout = {\n        title: \"Worked Time (60hrs./week)\",\n        height: 300,\n        margin: {\n          l: 150,\n          r: 20,\n          t: 50,\n          b: 50\n        },\n        xaxis: {\n          title: \"Hours\",\n          automargin: true\n        },\n        yaxis: {\n          automargin: true\n        },\n        responsive: true\n      };\n      Plotly.newPlot(\"worked-time-chart\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","Array","mounted","drawChart","methods","chartData","x","map","emp","hours","y","firstname","lastname","type","orientation","marker","color","layout","title","height","margin","l","r","t","b","xaxis","automargin","yaxis","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\WorkedTimeChart.vue"],"sourcesContent":["<template>\r\n    <div id=\"worked-time-chart\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"WorkedTimeChart\",\r\n    props: {\r\n      data: Array,\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            x: this.data.map(emp => emp.hours),\r\n            y: this.data.map(emp => `${emp.firstname} ${emp.lastname}`),\r\n            type: \"bar\",\r\n            orientation: \"h\",\r\n            marker: {\r\n              color: this.data.map(emp => (emp.hours > 60 ? \"red\" : \"yellow\")),\r\n            },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n        title: \"Worked Time (60hrs./week)\",\r\n        height: 300,\r\n        margin: { l: 150, r: 20, t: 50, b: 50 },\r\n        xaxis: { title: \"Hours\", automargin: true },\r\n        yaxis: { automargin: true },\r\n        responsive: true,\r\n      };\r\n  \r\n        Plotly.newPlot(\"worked-time-chart\", chartData, layout);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #worked-time-chart {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":";;AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE;IACLC,IAAI,EAAEC;EACR,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACPD,SAASA,CAAA,EAAG;MACV,MAAME,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAE,IAAI,CAACN,IAAI,CAACO,GAAG,CAACC,GAAE,IAAKA,GAAG,CAACC,KAAK,CAAC;QAClCC,CAAC,EAAE,IAAI,CAACV,IAAI,CAACO,GAAG,CAACC,GAAE,IAAK,GAAGA,GAAG,CAACG,SAAS,IAAIH,GAAG,CAACI,QAAQ,EAAE,CAAC;QAC3DC,IAAI,EAAE,KAAK;QACXC,WAAW,EAAE,GAAG;QAChBC,MAAM,EAAE;UACNC,KAAK,EAAE,IAAI,CAAChB,IAAI,CAACO,GAAG,CAACC,GAAE,IAAMA,GAAG,CAACC,KAAI,GAAI,EAAC,GAAI,KAAI,GAAI,QAAS;QACjE;MACF,CAAC,CACF;MAED,MAAMQ,MAAK,GAAI;QACfC,KAAK,EAAE,2BAA2B;QAClCC,MAAM,EAAE,GAAG;QACXC,MAAM,EAAE;UAAEC,CAAC,EAAE,GAAG;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE,EAAE;UAAEC,CAAC,EAAE;QAAG,CAAC;QACvCC,KAAK,EAAE;UAAEP,KAAK,EAAE,OAAO;UAAEQ,UAAU,EAAE;QAAK,CAAC;QAC3CC,KAAK,EAAE;UAAED,UAAU,EAAE;QAAK,CAAC;QAC3BE,UAAU,EAAE;MACd,CAAC;MAEC/B,MAAM,CAACgC,OAAO,CAAC,mBAAmB,EAAExB,SAAS,EAAEY,MAAM,CAAC;IACxD;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}