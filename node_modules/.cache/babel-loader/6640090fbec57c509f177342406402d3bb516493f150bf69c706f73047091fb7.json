{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: \"EmployeeTable\",\n  data() {\n    return {\n      employees: [] // สร้างตัวแปร employees เพื่อเก็บข้อมูลจาก API\n    };\n  },\n  mounted() {\n    this.fetchEmployeeData(); // เมื่อ component ถูก mount ให้ดึงข้อมูลจาก API\n  },\n  methods: {\n    // ฟังก์ชันในการดึงข้อมูลจาก API\n    async fetchEmployeeData() {\n      try {\n        const response = await axios.get(\"http://localhost:5000/api/EmployeeGateEntry\");\n        console.log(\"Data from API:\", response.data); // ดูข้อมูลที่ได้รับ\n        this.employees = response.data; // เก็บข้อมูลในตัวแปร employees\n      } catch (error) {\n        console.error(\"There was an error fetching the data:\", error);\n      }\n    },\n    getStatusClass(status) {\n      return {\n        \"status-in-cleanroom\": status === \"In Cleanroom\",\n        \"status-out-cleanroom\": status === \"Out Cleanroom\",\n        \"status-missing\": status === \"ขาดงาน\"\n      };\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","employees","mounted","fetchEmployeeData","methods","response","get","console","log","error","getStatusClass","status"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeTable.vue"],"sourcesContent":["<template>\r\n  <div class=\"employee-table\">\r\n    <h3>Head Count</h3>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th>No.</th>\r\n          <th>EmpID</th>\r\n          <th>Firstname</th>\r\n          <th>Lastname</th>\r\n          <th class=\"datetime-column\">Date-time</th>\r\n          <th>Gate No</th>\r\n          <th>Division</th>\r\n          <th>Department</th>\r\n          <th>Biz</th>\r\n          <th>Process</th>\r\n          <th>CourseGroup</th>\r\n          <th>WorkGroup</th>\r\n          <th>Status</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(employee, index) in employees\" :key=\"index\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ employee.empID }}</td>\r\n          <td>{{ employee.firstName }}</td>\r\n          <td>{{ employee.lastName }}</td>\r\n          <td class=\"datetime-column\">{{ employee.checkInDateTime || '-' }}</td> <!-- แก้ไขเป็น checkInDateTime -->\r\n          <td>{{ employee.gateNo || '-' }}</td> <!-- แก้ไขให้แสดงค่า \"-\" เมื่อไม่มีข้อมูล -->\r\n          <td>{{ employee.division || '-' }}</td>\r\n          <td>{{ employee.department || '-' }}</td>\r\n          <td>{{ employee.biz || '-' }}</td>\r\n          <td>{{ employee.process || '-' }}</td>\r\n          <td>{{ employee.courseGroup || '-' }}</td>\r\n          <td>{{ employee.WorkGroup || '-' }}</td>\r\n          <td :class=\"getStatusClass(employee.CStatus)\">\r\n            {{ employee.CStatus || '-' }} <!-- เพิ่มการแสดงค่า \"-\" เมื่อไม่มีข้อมูล -->\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: \"EmployeeTable\",\r\n  data() {\r\n    return {\r\n      employees: []  // สร้างตัวแปร employees เพื่อเก็บข้อมูลจาก API\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchEmployeeData();  // เมื่อ component ถูก mount ให้ดึงข้อมูลจาก API\r\n  },\r\n  methods: {\r\n    // ฟังก์ชันในการดึงข้อมูลจาก API\r\n    async fetchEmployeeData() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:5000/api/EmployeeGateEntry\");\r\n        console.log(\"Data from API:\", response.data);  // ดูข้อมูลที่ได้รับ\r\n        this.employees = response.data;  // เก็บข้อมูลในตัวแปร employees\r\n      } catch (error) {\r\n        console.error(\"There was an error fetching the data:\", error);\r\n      }\r\n    },\r\n    getStatusClass(status) {\r\n      return {\r\n        \"status-in-cleanroom\": status === \"In Cleanroom\",\r\n        \"status-out-cleanroom\": status === \"Out Cleanroom\",\r\n        \"status-missing\": status === \"ขาดงาน\",\r\n      };\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n  .employee-table {\r\n    margin-top: 20px;\r\n  }\r\n\r\n  table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n\r\n  th,\r\n  td {\r\n    padding: 10px;\r\n    text-align: center;\r\n    border: 1px solid #ddd;\r\n  }\r\n\r\n  th {\r\n    background-color: #f4f4f4;\r\n  }\r\n\r\n  .status-in-cleanroom {\r\n    color: green;\r\n  }\r\n\r\n  .status-out-cleanroom {\r\n    color: orange;\r\n  }\r\n\r\n  .status-missing {\r\n    color: red;\r\n  }\r\n\r\n  .datetime-column {\r\n    white-space: nowrap;\r\n  }\r\n</style>\r\n"],"mappings":"AA6CA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAC,CAAG;IACjB,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,iBAAiB,CAAC,CAAC,EAAG;EAC7B,CAAC;EACDC,OAAO,EAAE;IACP;IACA,MAAMD,iBAAiBA,CAAA,EAAG;MACxB,IAAI;QACF,MAAME,QAAO,GAAI,MAAMP,KAAK,CAACQ,GAAG,CAAC,6CAA6C,CAAC;QAC/EC,OAAO,CAACC,GAAG,CAAC,gBAAgB,EAAEH,QAAQ,CAACL,IAAI,CAAC,EAAG;QAC/C,IAAI,CAACC,SAAQ,GAAII,QAAQ,CAACL,IAAI,EAAG;MACnC,EAAE,OAAOS,KAAK,EAAE;QACdF,OAAO,CAACE,KAAK,CAAC,uCAAuC,EAAEA,KAAK,CAAC;MAC/D;IACF,CAAC;IACDC,cAAcA,CAACC,MAAM,EAAE;MACrB,OAAO;QACL,qBAAqB,EAAEA,MAAK,KAAM,cAAc;QAChD,sBAAsB,EAAEA,MAAK,KAAM,eAAe;QAClD,gBAAgB,EAAEA,MAAK,KAAM;MAC/B,CAAC;IACH;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}