{"ast":null,"code":"import PieChart from \"./../components/PieChart.vue\";\nimport BarChart from \"./../components/BarChart.vue\";\nimport EmployeeTable from \"./../components/EmployeeTable.vue\";\nimport EmployeeRecommendations from \"./../components/EmployeeRecommendations.vue\";\nimport EmployeeSkillTable from \"./../components/EmployeeSkillTable.vue\";\nimport SkillLevelPieChart from \"./../components/SkillLevelPieChart.vue\";\nimport EmployeeSkillSection from \"./../components/EmployeeSkillSection.vue\";\nimport fullySkilledPieChart from \"./../components/fullySkilledPieChart.vue\";\nimport WorkedTimeChart from \"./../components/WorkedTimeChart.vue\";\nimport WeeklyAbsentTrend from \"./../components/WeeklyAbsentTrend.vue\";\nimport MonthlyWorkedTimeOverload from \"./../components/MonthlyWorkedTimeOverload.vue\";\nimport ResourceAllocationSummary from \"./../components/ResourceAllocationSummary.vue\";\nimport ShiftRequireSupport from \"./../components/ShiftRequireSupport.vue\";\nimport ShiftcodeRequireSupport from \"./../components/ShiftcodeRequireSupport.vue\";\nimport WeeklyOvertime from \"./../components/WeeklyOvertime.vue\";\nimport HeadcountPlan from \"./../components/HeadcountPlan.vue\";\nimport axios from \"axios\";\nexport default {\n  components: {\n    PieChart,\n    BarChart,\n    EmployeeTable,\n    EmployeeRecommendations,\n    EmployeeSkillTable,\n    SkillLevelPieChart,\n    EmployeeSkillSection,\n    fullySkilledPieChart,\n    WorkedTimeChart,\n    WeeklyAbsentTrend,\n    MonthlyWorkedTimeOverload,\n    ResourceAllocationSummary,\n    ShiftRequireSupport,\n    ShiftcodeRequireSupport,\n    WeeklyOvertime,\n    HeadcountPlan\n  },\n  data() {\n    return {\n      stats: [{\n        value: \"7:15\",\n        label: \"SHIFT : DAY\",\n        subLabel: \"3/10/2024\",\n        icon: \"clock.png\"\n      }, {\n        value: 150,\n        label: \"พนักงานทั้งหมด\",\n        subLabel: \"คน\"\n      }, {\n        value: 85,\n        label: \"In Cleanroom\",\n        subLabel: \"คน\",\n        dotColor: \"#00cc66\"\n      }, {\n        value: 33,\n        label: \"Out Cleanroom\",\n        subLabel: \"คน\",\n        dotColor: \"#ffcc00\"\n      }, {\n        value: 0,\n        label: \"ขาดงาน\",\n        subLabel: \"คน\",\n        dotColor: \"#ff6666\"\n      }, {\n        value: 11,\n        label: \"ต้องการพนักงาน\",\n        subLabel: \"คน\"\n      }],\n      pieChartData: {\n        values: [85, 33, 5],\n        labels: [\"In Cleanroom\", \"Out Cleanroom\", \"ขาดงาน\"],\n        type: \"pie\"\n      }\n      // More data variables here...\n    };\n  },\n  mounted() {\n    this.fetchCleanroomData();\n  },\n  methods: {\n    async fetchCleanroomData() {\n      try {\n        const response = await axios.get(\"http://localhost:5000/api/cleanroom\");\n        const data = response.data;\n        this.stats[1].value = data.InCleanroom;\n        this.stats[2].value = data.OutCleanroom;\n        this.pieChartData.values = [data.InCleanroom, data.OutCleanroom];\n      } catch (error) {\n        console.error(\"Error fetching cleanroom status:\", error);\n      }\n    },\n    resetFilters() {\n      console.log(\"Filters reset. Showing all employees.\");\n    }\n    // Add other methods here...\n  }\n};","map":{"version":3,"names":["PieChart","BarChart","EmployeeTable","EmployeeRecommendations","EmployeeSkillTable","SkillLevelPieChart","EmployeeSkillSection","fullySkilledPieChart","WorkedTimeChart","WeeklyAbsentTrend","MonthlyWorkedTimeOverload","ResourceAllocationSummary","ShiftRequireSupport","ShiftcodeRequireSupport","WeeklyOvertime","HeadcountPlan","axios","components","data","stats","value","label","subLabel","icon","dotColor","pieChartData","values","labels","type","mounted","fetchCleanroomData","methods","response","get","InCleanroom","OutCleanroom","error","console","resetFilters","log"],"sources":["C:\\JecII\\SPFront\\src\\views\\DashboardMFG.vue"],"sourcesContent":["<template>\r\n  <div class=\"DashboardMFG\">\r\n    <header class=\"header\">\r\n      <img src=\"logo.png\" alt=\"Sony Logo\" class=\"logo\" />\r\n      <div class=\"filters\">\r\n        <select>\r\n          <option>Division : ALL</option>\r\n        </select>\r\n        <select>\r\n          <option>Department : ALL</option>\r\n        </select>\r\n        <select>\r\n          <option>Section : ALL</option>\r\n        </select>\r\n        <select>\r\n          <option>Biz : ALL</option>\r\n        </select>\r\n        <select>\r\n          <option>Process : ALL</option>\r\n        </select>\r\n        <input type=\"text\" placeholder=\"Search\" />\r\n      </div>\r\n    </header>\r\n\r\n    <!-- สถิติ -->\r\n    <section class=\"stats\">\r\n      <div class=\"stat-card\" v-for=\"(card, index) in stats\" :key=\"index\">\r\n        <div class=\"icon-container\">\r\n          <span\r\n            v-if=\"card.dotColor\"\r\n            :style=\"{ backgroundColor: card.dotColor }\"\r\n            class=\"status-dot\"\r\n          ></span>\r\n          <img v-else-if=\"card.icon\" :src=\"card.icon\" alt=\"Icon\" class=\"icon\" />\r\n        </div>\r\n        <div class=\"content\">\r\n          <h3\r\n            :style=\"{\r\n              color: card.label === 'ต้องการพนักงาน' ? '#ff0000' : '#000',\r\n            }\"\r\n          >\r\n            {{ card.value }}\r\n          </h3>\r\n          <p>{{ card.label }}</p>\r\n          <p v-if=\"card.subLabel\" class=\"sub-label\">{{ card.subLabel }}</p>\r\n        </div>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- โซน Pie Chart และ Employee Table -->\r\n    <section class=\"charts\">\r\n      <div class=\"chart\">\r\n        <button @click=\"resetFilters\">\r\n          <img src=\"refresh.png\" alt=\"Refresh\" class=\"refresh-icon\" />\r\n        </button>\r\n        <PieChart :data=\"pieChartData\" @filter=\"filterEmployeesByStatus\" />\r\n      </div>\r\n      <div class=\"table\">\r\n        <EmployeeTable\r\n          :employees=\"\r\n            filteredEmployees.length > 0 ? filteredEmployees : sortedEmployees\r\n          \"\r\n        />\r\n      </div>\r\n    </section>\r\n\r\n    <!-- โซน Bar Chart และ EmployeeRecommendations -->\r\n    <section class=\"charts\">\r\n      <div class=\"chart\">\r\n        <BarChart :data=\"barChartData\" @filterSkill=\"filterEmployeesBySkill1\" />\r\n      </div>\r\n      <div class=\"table\">\r\n        <EmployeeRecommendations\r\n          :employees=\"recommendedEmployees\"\r\n          :skills=\"skills\"\r\n          @selectEmployee=\"selectEmployee\"\r\n        />\r\n      </div>\r\n    </section>\r\n  </div>\r\n\r\n  <!-- โซน EmployeeSkillSection -->\r\n  <section class=\"charts\">\r\n    <div class=\"table\">\r\n      <EmployeeSkillTable\r\n        :employees=\"employees\"\r\n        :skills=\"skills\"\r\n        @selectEmployee=\"selectEmployee\"\r\n      />\r\n    </div>\r\n    <div class=\"table\" ref=\"skillSection\">\r\n      <EmployeeSkillSection\r\n        v-if=\"selectedEmployee\"\r\n        :employee=\"selectedEmployee\"\r\n        :skills=\"skills\"\r\n      />\r\n    </div>\r\n  </section>\r\n\r\n  <!-- โซน Pie Chart Skill Level และ EmployeeSkillTable -->\r\n  <section class=\"charts\">\r\n    <div class=\"chart\">\r\n      <button @click=\"resetFilters\">\r\n        <img src=\"refresh.png\" alt=\"Refresh\" class=\"refresh-icon\" />\r\n      </button>\r\n      <SkillLevelPieChart\r\n        :data=\"skillDistribution\"\r\n        @filter=\"filterEmployeesBySkillLevel\"\r\n      />\r\n    </div>\r\n    <div class=\"table\">\r\n      <EmployeeSkillTable\r\n        :employees=\"filteredSkillEmployees\"\r\n        :skills=\"skills\"\r\n        @selectEmployee=\"selectEmployee\"\r\n      />\r\n    </div>\r\n  </section>\r\n\r\n  <section class=\"charts\">\r\n    <div class=\"chart\">\r\n      <button @click=\"resetFilters\">\r\n        <img src=\"refresh.png\" alt=\"Refresh\" class=\"refresh-icon\" />\r\n      </button>\r\n      <fullySkilledPieChart\r\n        :data=\"fullySkilled\"\r\n        @filter=\"filterEmployeesBySkill2\"\r\n      />\r\n    </div>\r\n    <div class=\"table\">\r\n      <EmployeeSkillTable\r\n        :employees=\"filteredFullySkilled\"\r\n        :skills=\"skills\"\r\n        @selectEmployee=\"selectEmployee\"\r\n      />\r\n    </div>\r\n  </section>\r\n\r\n  <!-- โซน WorkedTimeChart และ MonthlyWorkedTimeOverload -->\r\n  <section class=\"charts\">\r\n    <div class=\"chart\">\r\n      <WorkedTimeChart :data=\"workedTimeData\" />\r\n    </div>\r\n    <div class=\"chart\">\r\n      <MonthlyWorkedTimeOverload :data=\"monthlyData\" />\r\n    </div>\r\n  </section>\r\n\r\n  <!-- โซน WeeklyAbsentTrend และ ResourceAllocationSummary -->\r\n  <section class=\"charts\">\r\n    <div class=\"chart\">\r\n      <WeeklyAbsentTrend :data=\"weeklyData\" />\r\n    </div>\r\n    <div class=\"chart\">\r\n      <ResourceAllocationSummary :data=\"resourceData\" />\r\n    </div>\r\n  </section>\r\n\r\n  <!-- โซน ShiftRequireSupport และ ShiftcodeRequireSupport -->\r\n  <section class=\"charts\">\r\n    <div class=\"chart\">\r\n      <ShiftcodeRequireSupport\r\n        :data=\"shiftcodeData\"\r\n        @filterShift=\"updateShiftFilter\"\r\n      />\r\n    </div>\r\n    <div class=\"chart\">\r\n      <ShiftRequireSupport :data=\"filteredShiftData\" />\r\n    </div>\r\n  </section>\r\n\r\n  <section class=\"charts\">\r\n    <div class=\"chart\">\r\n      <WeeklyOvertime :data=\"overtimeData\" />\r\n    </div>\r\n    <div class=\"chart\">\r\n      <HeadcountPlan :data=\"headcountData\" />\r\n    </div>\r\n  </section>\r\n</template>\r\n\r\n<script>\r\nimport PieChart from \"./../components/PieChart.vue\";\r\nimport BarChart from \"./../components/BarChart.vue\";\r\nimport EmployeeTable from \"./../components/EmployeeTable.vue\";\r\nimport EmployeeRecommendations from \"./../components/EmployeeRecommendations.vue\";\r\nimport EmployeeSkillTable from \"./../components/EmployeeSkillTable.vue\";\r\nimport SkillLevelPieChart from \"./../components/SkillLevelPieChart.vue\";\r\nimport EmployeeSkillSection from \"./../components/EmployeeSkillSection.vue\";\r\nimport fullySkilledPieChart from \"./../components/fullySkilledPieChart.vue\";\r\nimport WorkedTimeChart from \"./../components/WorkedTimeChart.vue\";\r\nimport WeeklyAbsentTrend from \"./../components/WeeklyAbsentTrend.vue\";\r\nimport MonthlyWorkedTimeOverload from \"./../components/MonthlyWorkedTimeOverload.vue\";\r\nimport ResourceAllocationSummary from \"./../components/ResourceAllocationSummary.vue\";\r\nimport ShiftRequireSupport from \"./../components/ShiftRequireSupport.vue\";\r\nimport ShiftcodeRequireSupport from \"./../components/ShiftcodeRequireSupport.vue\";\r\nimport WeeklyOvertime from \"./../components/WeeklyOvertime.vue\";\r\nimport HeadcountPlan from \"./../components/HeadcountPlan.vue\";\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  components: {\r\n    PieChart,\r\n    BarChart,\r\n    EmployeeTable,\r\n    EmployeeRecommendations,\r\n    EmployeeSkillTable,\r\n    SkillLevelPieChart,\r\n    EmployeeSkillSection,\r\n    fullySkilledPieChart,\r\n    WorkedTimeChart,\r\n    WeeklyAbsentTrend,\r\n    MonthlyWorkedTimeOverload,\r\n    ResourceAllocationSummary,\r\n    ShiftRequireSupport,\r\n    ShiftcodeRequireSupport,\r\n    WeeklyOvertime,\r\n    HeadcountPlan,\r\n  },\r\n  data() {\r\n    return {\r\n      stats: [\r\n        {\r\n          value: \"7:15\",\r\n          label: \"SHIFT : DAY\",\r\n          subLabel: \"3/10/2024\",\r\n          icon: \"clock.png\",\r\n        },\r\n        { value: 150, label: \"พนักงานทั้งหมด\", subLabel: \"คน\" },\r\n        {\r\n          value: 85,\r\n          label: \"In Cleanroom\",\r\n          subLabel: \"คน\",\r\n          dotColor: \"#00cc66\",\r\n        },\r\n        {\r\n          value: 33,\r\n          label: \"Out Cleanroom\",\r\n          subLabel: \"คน\",\r\n          dotColor: \"#ffcc00\",\r\n        },\r\n        { value: 0, label: \"ขาดงาน\", subLabel: \"คน\", dotColor: \"#ff6666\" },\r\n        { value: 11, label: \"ต้องการพนักงาน\", subLabel: \"คน\" },\r\n      ],\r\n      pieChartData: {\r\n        values: [85, 33, 5],\r\n        labels: [\"In Cleanroom\", \"Out Cleanroom\", \"ขาดงาน\"],\r\n        type: \"pie\",\r\n      },\r\n      // More data variables here...\r\n    };\r\n  },\r\n  mounted() {\r\n    this.fetchCleanroomData();\r\n  },\r\n  methods: {\r\n    async fetchCleanroomData() {\r\n      try {\r\n        const response = await axios.get(\"http://localhost:5000/api/cleanroom\");\r\n        const data = response.data;\r\n        this.stats[1].value = data.InCleanroom;\r\n        this.stats[2].value = data.OutCleanroom;\r\n        this.pieChartData.values = [data.InCleanroom, data.OutCleanroom];\r\n      } catch (error) {\r\n        console.error(\"Error fetching cleanroom status:\", error);\r\n      }\r\n    },\r\n    resetFilters() {\r\n      console.log(\"Filters reset. Showing all employees.\");\r\n    },\r\n    // Add other methods here...\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#skill-level-pie-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":"AAsLA,OAAOA,QAAO,MAAO,8BAA8B;AACnD,OAAOC,QAAO,MAAO,8BAA8B;AACnD,OAAOC,aAAY,MAAO,mCAAmC;AAC7D,OAAOC,uBAAsB,MAAO,6CAA6C;AACjF,OAAOC,kBAAiB,MAAO,wCAAwC;AACvE,OAAOC,kBAAiB,MAAO,wCAAwC;AACvE,OAAOC,oBAAmB,MAAO,0CAA0C;AAC3E,OAAOC,oBAAmB,MAAO,0CAA0C;AAC3E,OAAOC,eAAc,MAAO,qCAAqC;AACjE,OAAOC,iBAAgB,MAAO,uCAAuC;AACrE,OAAOC,yBAAwB,MAAO,+CAA+C;AACrF,OAAOC,yBAAwB,MAAO,+CAA+C;AACrF,OAAOC,mBAAkB,MAAO,yCAAyC;AACzE,OAAOC,uBAAsB,MAAO,6CAA6C;AACjF,OAAOC,cAAa,MAAO,oCAAoC;AAC/D,OAAOC,aAAY,MAAO,mCAAmC;AAC7D,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,UAAU,EAAE;IACVjB,QAAQ;IACRC,QAAQ;IACRC,aAAa;IACbC,uBAAuB;IACvBC,kBAAkB;IAClBC,kBAAkB;IAClBC,oBAAoB;IACpBC,oBAAoB;IACpBC,eAAe;IACfC,iBAAiB;IACjBC,yBAAyB;IACzBC,yBAAyB;IACzBC,mBAAmB;IACnBC,uBAAuB;IACvBC,cAAc;IACdC;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,CACL;QACEC,KAAK,EAAE,MAAM;QA