{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"FullySkilledPieChart\",\n  props: {\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const chartData = [{\n        values: this.data.values,\n        // เช่น [80, 20]\n        labels: this.data.labels,\n        // เช่น [\"Fully Skilled\", \"Need Training\"]\n        type: \"pie\",\n        marker: {\n          colors: [\"green\", \"red\"] // สีสำหรับ Fully Skilled และ Need Training\n        }\n      }];\n      const layout = {\n        title: \"Skill Competency Overview\",\n        // ชื่อกราฟ\n        height: 450,\n        width: 450,\n        paper_bgcolor: 'rgba(0,0,0,0)' // พื้นหลังด้านนอกเป็น transparent\n      };\n      Plotly.newPlot(\"fully-skilled-pie-chart\", chartData, layout).then(() => {\n        document.getElementById(\"fully-skilled-pie-chart\").on(\"plotly_click\", this.onSliceClick);\n      });\n    },\n    onSliceClick(eventData) {\n      if (eventData.points && eventData.points.length > 0) {\n        const sliceLabel = eventData.points[0].label;\n        this.$emit(\"filter\", sliceLabel);\n      }\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","mounted","drawChart","methods","chartData","values","labels","marker","colors","layout","title","height","width","paper_bgcolor","newPlot","then","document","getElementById","on","onSliceClick","eventData","points","length","sliceLabel","label","$emit"],"sources":["C:\\JecII\\SPFront\\src\\components\\fullySkilledPieChart.vue"],"sourcesContent":["<template>\r\n    <div id=\"fully-skilled-pie-chart\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"FullySkilledPieChart\",\r\n    props: {\r\n      data: {\r\n        type: Object,\r\n        required: true,\r\n      },\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            values: this.data.values, // เช่น [80, 20]\r\n            labels: this.data.labels, // เช่น [\"Fully Skilled\", \"Need Training\"]\r\n            type: \"pie\",\r\n            marker: {\r\n              colors: [\"green\", \"red\"], // สีสำหรับ Fully Skilled และ Need Training\r\n            },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n          title: \"Skill Competency Overview\", // ชื่อกราฟ\r\n          height: 450,\r\n          width: 450,\r\n          paper_bgcolor: 'rgba(0,0,0,0)', // พื้นหลังด้านนอกเป็น transparent\r\n        };\r\n  \r\n        Plotly.newPlot(\"fully-skilled-pie-chart\", chartData, layout).then(() => {\r\n          document\r\n            .getElementById(\"fully-skilled-pie-chart\")\r\n            .on(\"plotly_click\", this.onSliceClick);\r\n        });\r\n      },\r\n      onSliceClick(eventData) {\r\n      if (eventData.points && eventData.points.length > 0) {\r\n        const sliceLabel = eventData.points[0].label;\r\n        this.$emit(\"filter\", sliceLabel);\r\n      }\r\n    },\r\n  },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #fully-skilled-pie-chart {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,sBAAsB;EAC5BC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACPD,SAASA,CAAA,EAAG;MACV,MAAME,SAAQ,GAAI,CAChB;QACEC,MAAM,EAAE,IAAI,CAACR,IAAI,CAACQ,MAAM;QAAE;QAC1BC,MAAM,EAAE,IAAI,CAACT,IAAI,CAACS,MAAM;QAAE;QAC1BR,IAAI,EAAE,KAAK;QACXS,MAAM,EAAE;UACNC,MAAM,EAAE,CAAC,OAAO,EAAE,KAAK,CAAC,CAAE;QAC5B;MACF,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACbC,KAAK,EAAE,2BAA2B;QAAE;QACpCC,MAAM,EAAE,GAAG;QACXC,KAAK,EAAE,GAAG;QACVC,aAAa,EAAE,eAAe,CAAE;MAClC,CAAC;MAEDnB,MAAM,CAACoB,OAAO,CAAC,y