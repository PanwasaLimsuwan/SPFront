{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.map.js\";\nimport \"core-js/modules/esnext.iterator.reduce.js\";\nimport Plotly from \"plotly.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"BarChart\",\n  data() {\n    return {\n      barChartData: []\n    };\n  },\n  mounted() {\n    this.fetchBarChartData();\n  },\n  watch: {\n    barChartData: {\n      handler() {\n        this.drawChart();\n      },\n      deep: true\n    }\n  },\n  methods: {\n    // ฟังก์ชันดึงข้อมูลจาก API\n    async fetchBarChartData() {\n      try {\n        const response = await axios.get(\"http://localhost:5000/api/BarChart\");\n        this.barChartData = response.data;\n      } catch (error) {\n        console.error(\"Error fetching bar chart data:\", error);\n      }\n    },\n    // ฟังก์ชันเพื่อวาดกราฟ\n    drawChart() {\n      const processData = this.barChartData.reduce((acc, item) => {\n        if (!acc[item.Process]) {\n          acc[item.Process] = {};\n        }\n        acc[item.Process][item.SkillGroup] = item.EmployeeCount;\n        return acc;\n      }, {});\n      const processes = Object.keys(processData);\n      const skillGroups = [\"Inspection\", \"Machine:SAB#1\", \"Machine:SAB#2\", \"Machine:SAB#3\", \"Material\", \"Operation\"];\n      const chartData = skillGroups.map(skillGroup => {\n        return {\n          x: processes,\n          y: processes.map(process => processData[process][skillGroup] || 0),\n          name: skillGroup,\n          type: \"bar\",\n          text: processes.map(process => processData[process][skillGroup] || 0),\n          textposition: \"auto\",\n          marker: {\n            color: \"#76c7c0\"\n          } // ปรับสีของกราฟ\n        };\n      });\n      const layout = {\n        title: \"Require Support (Process)\",\n        barmode: \"stack\",\n        height: 400,\n        width: 700,\n        legend: {\n          orientation: \"v\",\n          