{"ast":null,"code":"import \"core-js/modules/esnext.iterator.map.js\";\nimport Plotly from \"plotly.js\";\nexport default {\n  name: \"SkillLevelPieChart\",\n  props: {\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    this.fetchSkillData(); // เรียกใช้ฟังก์ชันดึงข้อมูล\n  },\n  methods: {\n    // ฟังก์ชันดึงข้อมูลจาก API\n    async fetchSkillData() {\n      try {\n        // เรียก API ที่เราสร้างใน C#\n        const response = await this.$axios.get(\"http://localhost:5000/api/SkillLevelPieChart\");\n        const skillData = response.data;\n\n        // แปลงข้อมูลที่ได้จาก API ให้เป็นรูปแบบที่สามารถใช้ในกราฟได้\n        this.drawChart(skillData);\n      } catch (error) {\n        console.error(\"Error fetching skill level data:\", error);\n      }\n    },\n    // ฟังก์ชันสร้างกราฟ\n    drawChart(skillData) {\n      const chartData = [{\n        values: skillData.map(item => item.SkillCount),\n        // จำนวนทักษะในแต่ละกลุ่ม\n        labels: skillData.map(item => item.SkillGroup),\n        // ชื่อทักษะเช่น Inspection, Machine, Operation\n        type: \"pie\",\n        marker: {\n          colors: [\"gray\", \"red\", \"yellow\", \"green\"] // สีสำหรับแต่ละระดับ\n        }\n      }];\n      const layout = {\n        title: \"Skill Level Distribution\",\n        // ชื่อกราฟ\n        height: 450,\n        width: 450\n      };\n      Plotly.newPlot(\"skill-level-pie-chart\", chartData, layout).then(() => {\n        document.getElementById(\"skill-level-pie-chart\").on(\"plotly_click\", this.onSliceClick);\n      });\n    },\n    // ฟังก์ชันจัดการเมื่อคลิกที่ส่วนต่าง ๆ ของกราฟ\n    onSliceClick(eventData) {\n      if (eventData.points && eventData.points.length > 0) {\n        const sliceLabel = eventData.points[0].label; // ดึง label (ชื่อ skill level)\n        console.log(\"Emitting Skill Level Label:\", sliceLabel);\n        this.$emit(\"filter\", sliceLabel); // ส่ง label ไปยัง parent component\n      } else {\n        console.error(\"Invalid Plotly Event Data:\", eventData);\n      }\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","mounted","fetchSkillData","methods","response","$axios","get","skillData","drawChart","error","console","chartData","values","map","item","SkillCount","labels","SkillGroup","marker","colors","layout","title","height","width","newPlot","then","document","getElementById","on","onSliceClick","eventData","points","length","sliceLabel","label","log","$emit"],"sources":["C:\\JecII\\SPFront\\src\\components\\SkillLevelPieChart.vue"],"sourcesContent":["<template>\r\n  <div id=\"skill-level-pie-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"SkillLevelPieChart\",\r\n  props: {\r\n    data: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n  },\r\n  mounted() {\r\n    this.fetchSkillData();  // เรียกใช้ฟังก์ชันดึงข้อมูล\r\n  },\r\n  methods: {\r\n    // ฟังก์ชันดึงข้อมูลจาก API\r\n    async fetchSkillData() {\r\n      try {\r\n        // เรียก API ที่เราสร้างใน C#\r\n        const response = await this.$axios.get(\"http://localhost:5000/api/SkillLevelPieChart\");\r\n        const skillData = response.data;\r\n        \r\n        // แปลงข้อมูลที่ได้จาก API ให้เป็นรูปแบบที่สามารถใช้ในกราฟได้\r\n        this.drawChart(skillData);\r\n      } catch (error) {\r\n        console.error(\"Error fetching skill level data:\", error);\r\n      }\r\n    },\r\n    // ฟังก์ชันสร้างกราฟ\r\n    drawChart(skillData) {\r\n      const chartData = [\r\n        {\r\n          values: skillData.map(item => item.SkillCount), // จำนวนทักษะในแต่ละกลุ่ม\r\n          labels: skillData.map(item => item.SkillGroup), // ชื่อทักษะเช่น Inspection, Machine, Operation\r\n          type: \"pie\",\r\n          marker: {\r\n            colors: [\"gray\", \"red\", \"yellow\", \"green\"], // สีสำหรับแต่ละระดับ\r\n          },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Skill Level Distribution\", // ชื่อกราฟ\r\n        height: 450,\r\n        width: 450,\r\n      };\r\n\r\n      Plotly.newPlot(\"skill-level-pie-chart\", chartData, layout).then(() => {\r\n        document\r\n          .getElementById(\"skill-level-pie-chart\")\r\n          .on(\"plotly_click\", this.onSliceClick);\r\n      });\r\n    },\r\n    // ฟังก์ชันจัดการเมื่อคลิกที่ส่วนต่าง ๆ ของกราฟ\r\n    onSliceClick(eventData) {\r\n      if (eventData.points && eventData.points.length > 0) {\r\n        const sliceLabel = eventData.points[0].label; // ดึง label (ชื่อ skill level)\r\n        console.log(\"Emitting Skill Level Label:\", sliceLabel);\r\n        this.$emit(\"filter\", sliceLabel); // ส่ง label ไปยัง parent component\r\n      } else {\r\n        console.error(\"Invalid Plotly Event Data:\", eventData);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#skill-level-pie-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";AAKA,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,cAAc,CAAC,CAAC,EAAG;EAC1B,CAAC;EACDC,OAAO,EAAE;IACP;IACA,MAAMD,cAAcA,CAAA,EAAG;MACrB,IAAI;QACF;QACA,MAAME,QAAO,GAAI,MAAM,IAAI,CAACC,MAAM,CAACC,GAAG,CAAC,8CAA8C,CAAC;QACtF,MAAMC,SAAQ,GAAIH,QAAQ,CAACP,IAAI;;QAE/B;QACA,IAAI,CAACW,SAAS,CAACD,SAAS,CAAC;MAC3B,EAAE,OAAOE,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,kCAAkC,EAAEA,KAAK,CAAC;MAC1D;IACF,CAAC;IACD;IACAD,SAASA,CAACD,SAAS,EAAE;MACnB,MAAMI,SAAQ,GAAI,CAChB;QACEC,MAAM,EAAEL,SAAS,CAACM,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACC,UAAU,CAAC;QAAE;QAChDC,MAAM,EAAET,SAAS,CAACM,GAAG,CAACC,IAAG,IAAKA,IAAI,CAACG,UAAU,CAAC;QAAE;QAChDnB,IAAI,EAAE,KAAK;QACXoB,MAAM,EAAE;UACNC,MAAM,EAAE,CAAC,MAAM,EAAE,KAAK,EAAE,QAAQ,EAAE,OAAO,CAAC,CAAE;QAC9C;MACF,CAAC,CACF;MAED,MAAMC,MAAK,GAAI;QACbC,KAAK,EAAE,0BAA0B;QAAE;QACnCC,MAAM,EAAE,GAAG;QACXC,KAAK,EAAE;MACT,CAAC;MAED7B,MAAM,CAA