{"ast":null,"code":"import Plotly from \"plotly.js\";\nexport default {\n  name: \"SkillLevelPieChart\",\n  props: {\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    this.drawChart();\n  },\n  methods: {\n    drawChart() {\n      const chartData = [{\n        values: this.data.values,\n        labels: this.data.labels,\n        // ส่ง label เป็นชื่อ skill level เช่น \"Expert\", \"Medium\"\n        type: \"pie\",\n        marker: {\n          colors: [\"gray\", \"red\", \"yellow\", \"green\"] // สีสำหรับแต่ละระดับ\n        }\n      }];\n      const layout = {\n        title: \"Skill Level Distribution\",\n        height: 450,\n        width: 450\n      };\n      Plotly.newPlot(\"skill-level-pie-chart\", chartData, layout).then(() => {\n        document.getElementById(\"skill-level-pie-chart\").on(\"plotly_click\", this.onSliceClick);\n      });\n    },\n    onSliceClick(eventData) {\n      if (eventData.points && eventData.points.length > 0) {\n        const sliceLabel = eventData.points[0].label; // ดึง label (ชื่อ skill level)\n        console.log(\"Emitting Skill Level Label:\", sliceLabel);\n        this.$emit(\"filter\", sliceLabel); // ส่ง label ไปยัง parent component\n      } else {\n        console.error(\"Invalid Plotly Event Data:\", eventData);\n      }\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","mounted","drawChart","methods","chartData","values","labels","marker","colors","layout","title","height","width","newPlot","then","document","getElementById","on","onSliceClick","eventData","points","length","sliceLabel","label","console","log","$emit","error"],"sources":["C:\\JecII\\SPFront\\src\\components\\SkillLevelPieChart.vue"],"sourcesContent":["<template>\r\n    <div id=\"skill-level-pie-chart\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"SkillLevelPieChart\",\r\n    props: {\r\n      data: {\r\n        type: Object,\r\n        required: true,\r\n      },\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            values: this.data.values,\r\n            labels: this.data.labels, // ส่ง label เป็นชื่อ skill level เช่น \"Expert\", \"Medium\"\r\n            type: \"pie\",\r\n            marker: {\r\n              colors: [\"gray\", \"red\", \"yellow\", \"green\"], // สีสำหรับแต่ละระดับ\r\n            },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n          title: \"Skill Level Distribution\",\r\n          height: 450,\r\n          width: 450,\r\n        };\r\n  \r\n        Plotly.newPlot(\"skill-level-pie-chart\", chartData, layout).then(() => {\r\n          document\r\n            .getElementById(\"skill-level-pie-chart\")\r\n            .on(\"plotly_click\", this.onSliceClick);\r\n        });\r\n      },\r\n      onSliceClick(eventData) {\r\n        if (eventData.points && eventData.points.length > 0) {\r\n          const sliceLabel = eventData.points[0].label; // ดึง label (ชื่อ skill level)\r\n          console.log(\"Emitting Skill Level Label:\", sliceLabel);\r\n          this.$emit(\"filter\", sliceLabel); // ส่ง label ไปยัง parent component\r\n        } else {\r\n          console.error(\"Invalid Plotly Event Data:\", eventData);\r\n        }\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #skill-level-pie-chart {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":"AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,oBAAoB;EAC1BC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,OAAO,EAAE;IACPD,SAASA,CAAA,EAAG;MACV,MAAME,SAAQ,GAAI,CAChB;QACEC,MAAM,EAAE,IAAI,CAACR,IAAI,CAACQ,MAAM;QACxBC,MAAM,EAAE,IAAI,CAACT,IAAI,CAACS,MAAM;QAAE;QAC1BR,IAAI,EAAE,KAAK;Q