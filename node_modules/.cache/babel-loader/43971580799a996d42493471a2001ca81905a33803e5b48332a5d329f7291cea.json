{"ast":null,"code":"export default {\n  props: {\n    skills: {\n      type: Array,\n      required: true\n    }\n  },\n  data() {\n    return {\n      employee: null // ข้อมูลพนักงานที่เลือก\n    };\n  },\n  methods: {\n    async fetchEmployeeSkill(empId) {\n      const response = await axios.get(`http://localhost:5000/api/EmployeeSkillSection/${empId}`);\n      this.employee = response.data; // เก็บข้อมูลพนักงาน\n    },\n    getSkillColor(level) {\n      if (level === 3) return \"green\";\n      if (level === 2) return \"yellow\";\n      if (level === 1) return \"red\";\n      if (level === 0) return \"gray\";\n      return \"transparent\";\n    }\n  },\n  watch: {\n    // ตรวจสอบเมื่อมีการส่ง empID\n    '$parent.selectedEmployeeId': function (newEmpID) {\n      this.fetchEmployeeSkill(newEmpID); // ดึงข้อมูลพนักงานตาม empID\n    }\n  }\n};","map":{"version":3,"names":["props","skills","type","Array","required","data","employee","methods","fetchEmployeeSkill","empId","response","axios","get","getSkillColor","level","watch","$parent.selectedEmployeeId","newEmpID"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"employee\" class=\"employee-section\">\r\n    <h3>{{ employee.Firstname }} {{ employee.Lastname }}</h3>\r\n    <div v-for=\"skill in skills\" :key=\"skill\">\r\n      <p>{{ skill }}: Level {{ employee[skill] }}</p>\r\n      <div\r\n        class=\"skill-bar\"\r\n        :style=\"{ \r\n          background: `linear-gradient(to right, ${getSkillColor(employee[skill])} ${(employee[skill] / 3) * 100}%, #ddd ${(employee[skill] / 3) * 100}%)`,\r\n          width: '100%'\r\n        }\"\r\n      ></div>\r\n    </div>\r\n  </div>\r\n  <p v-else>กรุณาเลือกพนักงาน</p>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: {\r\n    skills: {\r\n      type: Array,\r\n      required: true,\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      employee: null,  // ข้อมูลพนักงานที่เลือก\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchEmployeeSkill(empId) {\r\n      const response = await axios.get(`http://localhost:5000/api/EmployeeSkillSection/${empId}`);\r\n      this.employee = response.data;  // เก็บข้อมูลพนักงาน\r\n    },\r\n    getSkillColor(level) {\r\n      if (level === 3) return \"green\";\r\n      if (level === 2) return \"yellow\";\r\n      if (level === 1) return \"red\";\r\n      if (level === 0) return \"gray\";\r\n      return \"transparent\";\r\n    },\r\n  },\r\n  watch: {\r\n    // ตรวจสอบเมื่อมีการส่ง empID\r\n    '$parent.selectedEmployeeId': function (newEmpID) {\r\n      this.fetchEmployeeSkill(newEmpID);  // ดึงข้อมูลพนักงานตาม empID\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n\r\n<style scoped>\r\n.employee-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.skill-bar {\r\n  height: 20px;\r\n  margin-bottom: 10px;\r\n  border-radius: 5px;\r\n  background-color: gray; /* Default */\r\n}\r\n</style>\r\n"],"mappings":"AAkBA,eAAe;EACbA,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,IAAI,CAAG;IACnB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,kBAAkBA,CAACC,KAAK,EAAE;MAC9B,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAACC,GAAG,CAAC,kDAAkDH,KAAK,EAAE,CAAC;MAC3F,IAAI,CAACH,QAAO,GAAII,QAAQ,CAACL,IAAI,EAAG;IAClC,CAAC;IACDQ,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,OAAO;MAC/B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,QAAQ;MAChC,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,KAAK;MAC7B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,MAAM;MAC9B,OAAO,aAAa;IACtB;EACF,CAAC;EACDC,KAAK,EAAE;IACL;IACA,4BAA4B,EAAE,SAAAC,CAAUC,QAAQ,EAAE;MAChD,IAAI,CAACT,kBAAkB,CAACS,QAAQ,CAAC,EAAG;IACtC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}