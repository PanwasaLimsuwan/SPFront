{"ast":null,"code":"import { openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  id: \"skill-level-pie-chart\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1);\n}","map":{"version":3,"names":["id","_createElementBlock","_hoisted_1"],"sources":["C:\\JecII\\SPFront\\src\\components\\SkillLevelPieChart.vue"],"sourcesContent":["<template>\r\n  <div id=\"skill-level-pie-chart\"></div>\r\n</template>\r\n\r\n<script>\r\nimport Plotly from \"plotly.js\";\r\n\r\nexport default {\r\n  name: \"SkillLevelPieChart\",\r\n  props: {\r\n    data: {\r\n      type: Object,\r\n      required: true,\r\n    },\r\n  },\r\n  mounted() {\r\n    this.fetchSkillData();  // เรียกใช้ฟังก์ชันดึงข้อมูล\r\n  },\r\n  methods: {\r\n    // ฟังก์ชันดึงข้อมูลจาก API\r\n    async fetchSkillData() {\r\n      try {\r\n        // เรียก API ที่เราสร้างใน C#\r\n        const response = await this.$axios.get(\"http://localhost:5000/api/SkillLevelPieChart\");\r\n        const skillData = response.data;\r\n        \r\n        // แปลงข้อมูลที่ได้จาก API ให้เป็นรูปแบบที่สามารถใช้ในกราฟได้\r\n        this.drawChart(skillData);\r\n      } catch (error) {\r\n        console.error(\"Error fetching skill level data:\", error);\r\n      }\r\n    },\r\n    // ฟังก์ชันสร้างกราฟ\r\n    drawChart(skillData) {\r\n      const chartData = [\r\n        {\r\n          values: skillData.map(item => item.SkillCount), // จำนวนทักษะในแต่ละกลุ่ม\r\n          labels: skillData.map(item => item.SkillGroup), // ชื่อทักษะเช่น Inspection, Machine, Operation\r\n          type: \"pie\",\r\n          marker: {\r\n            colors: [\"gray\", \"red\", \"yellow\", \"green\"], // สีสำหรับแต่ละระดับ\r\n          },\r\n        },\r\n      ];\r\n\r\n      const layout = {\r\n        title: \"Skill Level Distribution\", // ชื่อกราฟ\r\n        height: 450,\r\n        width: 450,\r\n      };\r\n\r\n      Plotly.newPlot(\"skill-level-pie-chart\", chartData, layout).then(() => {\r\n        document\r\n          .getElementById(\"skill-level-pie-chart\")\r\n          .on(\"plotly_click\", this.onSliceClick);\r\n      });\r\n    },\r\n    // ฟังก์ชันจัดการเมื่อคลิกที่ส่วนต่าง ๆ ของกราฟ\r\n    onSliceClick(eventData) {\r\n      if (eventData.points && eventData.points.length > 0) {\r\n        const sliceLabel = eventData.points[0].label; // ดึง label (ชื่อ skill level)\r\n        console.log(\"Emitting Skill Level Label:\", sliceLabel);\r\n        this.$emit(\"filter\", sliceLabel); // ส่ง label ไปยัง parent component\r\n      } else {\r\n        console.error(\"Invalid Plotly Event Data:\", eventData);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n#skill-level-pie-chart {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n</style>\r\n"],"mappings":";;EACOA,EAAE,EAAC;AAAuB;;uBAA/BC,mBAAA,CAAsC,OAAtCC,UAAsC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}