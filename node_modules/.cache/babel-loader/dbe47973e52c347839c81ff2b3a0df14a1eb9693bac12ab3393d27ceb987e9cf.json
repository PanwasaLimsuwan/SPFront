{"ast":null,"code":"export default {\n  data() {\n    return {\n      employees: [],\n      // รายการพนักงาน\n      skills: [\"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"]\n    };\n  },\n  methods: {\n    async fetchEmployeeSkills() {\n      const response = await axios.get(\"http://localhost:5000/api/EmployeeSkill\");\n      this.employees = response.data;\n    },\n    selectEmployee(empID) {\n      // ส่ง empID ไปยัง parent component\n      this.$emit('selectEmployee', empID);\n    }\n  }\n};","map":{"version":3,"names":["data","employees","skills","methods","fetchEmployeeSkills","response","axios","get","selectEmployee","empID","$emit"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillTable.vue"],"sourcesContent":["<template>\r\n  <div class=\"employee-skill-table\">\r\n    <h3>Employee Skill</h3>\r\n    <table>\r\n      <thead>\r\n        <tr>\r\n          <th>No.</th>\r\n          <th>EmpID</th>\r\n          <th>Firstname</th>\r\n          <th>Lastname</th>\r\n          <th v-for=\"skill in skills\" :key=\"skill\">{{ skill }}</th>\r\n          <th>Select</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(employee, index) in employees\" :key=\"employee.empID\">\r\n          <td>{{ index + 1 }}</td>\r\n          <td>{{ employee.empID }}</td>\r\n          <td>{{ employee.firstName }}</td>\r\n          <td>{{ employee.lastName }}</td>\r\n          <td\r\n            v-for=\"skill in skills\"\r\n            :key=\"skill\"\r\n            :class=\"getSkillLevelClass(employee[skill])\"\r\n          >\r\n            {{ employee[skill] }}\r\n          </td>\r\n          <td>\r\n            <button @click=\"selectEmployee(employee.empID)\">\r\n              <img src=\"skill.png\" alt=\"Skill\" class=\"skill-icon\" />\r\n            </button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  data() {\r\n    return {\r\n      employees: [],  // รายการพนักงาน\r\n      skills: [\"material\", \"operation\", \"machine_SAB1\", \"machine_SAB2\", \"machine_SAB3\", \"inspection\"],\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchEmployeeSkills() {\r\n      const response = await axios.get(\"http://localhost:5000/api/EmployeeSkill\");\r\n      this.employees = response.data;\r\n    },\r\n    selectEmployee(empID) {\r\n      // ส่ง empID ไปยัง parent component\r\n      this.$emit('selectEmployee', empID);\r\n    },\r\n  },\r\n};\r\n</script>\r\n"],"mappings":"AAuCA,eAAe;EACbA,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,EAAE;MAAG;MAChBC,MAAM,EAAE,CAAC,UAAU,EAAE,WAAW,EAAE,cAAc,EAAE,cAAc,EAAE,cAAc,EAAE,YAAY;IAChG,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,mBAAmBA,CAAA,EAAG;MAC1B,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAACC,GAAG,CAAC,yCAAyC,CAAC;MAC3E,IAAI,CAACN,SAAQ,GAAII,QAAQ,CAACL,IAAI;IAChC,CAAC;IACDQ,cAAcA,CAACC,KAAK,EAAE;MACpB;MACA,IAAI,CAACC,KAAK,CAAC,gBAAgB,EAAED,KAAK,CAAC;IACrC;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}