{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport Plotly from \"plotly.js\";\nexport default {\n  name: \"HeadcountTransitionChart\",\n  props: {\n    data: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    this.drawChart();\n  },\n  watch: {\n    data: {\n      deep: true,\n      handler() {\n        this.drawChart();\n      }\n    }\n  },\n  methods: {\n    drawChart() {\n      const months = this.data.months || []; // X-axis: Months\n      const newEmployees = this.data.newEmployees || []; // Y-axis: New employees\n      const resignedEmployees = this.data.resignedEmployees || []; // Y-axis: Resigned employees\n\n      const chartData = [{\n        x: months,\n        y: newEmployees,\n        name: \"พนักงานใหม่\",\n        // New employees\n        type: \"bar\",\n        marker: {\n          color: \"blue\"\n        }\n      }, {\n        x: months,\n        y: resignedEmployees.map(value => -value),\n        // Negative values for resigned employees\n        name: \"พนักงานที่ลาออก\",\n        // Resigned employees\n        type: \"bar\",\n        marker: {\n          color: \"red\"\n        }\n      }];\n      const layout = {\n        title: \"Headcount Transition\",\n        barmode: \"relative\",\n        height: 500,\n        //   width: 1000,\n        xaxis: {\n          title: \"Months\",\n          showgrid: false\n        },\n        yaxis: {\n          title: \"Number of Employees\"\n        },\n        legend: {\n          x: 1,\n          y: 1\n        },\n        paper_bgcolor: \"rgba(0,0,0,0)\",\n        //   plot_bgcolor: \"rgba(0,0,0,0)\",\n        responsive: true\n      };\n      Plotly.newPlot(\"headcount-transition-chart\", chartData, layout);\n    }\n  }\n};","map":{"version":3,"names":["Plotly","name","props","data","type","Object","required","mounted","drawChart","watch","deep","handler","methods","months","newEmployees","resignedEmployees","chartData","x","y","marker","color","map","value","layout","title","barmode","height","xaxis","showgrid","yaxis","legend","paper_bgcolor","responsive","newPlot"],"sources":["C:\\JecII\\SPFront\\src\\components\\HeadcounTransition.vue"],"sourcesContent":["<template>\r\n    <div id=\"headcount-transition-chart\"></div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"HeadcountTransitionChart\",\r\n    props: {\r\n      data: {\r\n        type: Object,\r\n        required: true,\r\n      },\r\n    },\r\n    mounted() {\r\n      this.drawChart();\r\n    },\r\n    watch: {\r\n      data: {\r\n        deep: true,\r\n        handler() {\r\n          this.drawChart();\r\n        },\r\n      },\r\n    },\r\n    methods: {\r\n      drawChart() {\r\n        const months = this.data.months || []; // X-axis: Months\r\n        const newEmployees = this.data.newEmployees || []; // Y-axis: New employees\r\n        const resignedEmployees = this.data.resignedEmployees || []; // Y-axis: Resigned employees\r\n  \r\n        const chartData = [\r\n          {\r\n            x: months,\r\n            y: newEmployees,\r\n            name: \"พนักงานใหม่\", // New employees\r\n            type: \"bar\",\r\n            marker: {\r\n              color: \"blue\",\r\n            },\r\n          },\r\n          {\r\n            x: months,\r\n            y: resignedEmployees.map((value) => -value), // Negative values for resigned employees\r\n            name: \"พนักงานที่ลาออก\", // Resigned employees\r\n            type: \"bar\",\r\n            marker: {\r\n              color: \"red\",\r\n            },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n          title: \"Headcount Transition\",\r\n          barmode: \"relative\",\r\n          height: 500,\r\n        //   width: 1000,\r\n          xaxis: {\r\n            title: \"Months\",\r\n            showgrid: false,\r\n          },\r\n          yaxis: {\r\n            title: \"Number of Employees\",\r\n          },\r\n          legend: {\r\n            x: 1,\r\n            y: 1,\r\n          },\r\n          paper_bgcolor: \"rgba(0,0,0,0)\",\r\n        //   plot_bgcolor: \"rgba(0,0,0,0)\",\r\n          responsive: true,\r\n        };\r\n  \r\n        Plotly.newPlot(\"headcount-transition-chart\", chartData, layout);\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #headcount-transition-chart {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":";;AAKE,OAAOA,MAAK,MAAO,WAAW;AAE9B,eAAe;EACbC,IAAI,EAAE,0BAA0B;EAChCC,KAAK,EAAE;IACLC,IAAI,EAAE;MACJC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,CAAC;EAClB,CAAC;EACDC,KAAK,EAAE;IACLN,IAAI,EAAE;MACJO,IAAI,EAAE,IAAI;MACVC,OAAOA,CAAA,EAAG;QACR,IAAI,CAACH,SAAS,CAAC,CAAC;MAClB;IACF;EACF,CAAC;EACDI,OAAO,EAAE;IACPJ,SAASA,CAAA,EAAG;MACV,MAAMK,MAAK,GAAI,IAAI,CAACV,IAAI,CAACU,MAAK,IAAK,EAAE,EAAE;MACvC,MAAMC,YAAW,GAAI,IAAI,CAACX,IAAI,CAACW,YAAW,IAAK,EAAE,EAAE;MACnD,MAAMC,iBAAgB,GAAI,IAAI,CAACZ,IAAI,CAACY,iBAAgB,IAAK,EAAE,EAAE;;MAE7D,MAAMC,SAAQ,GAAI,CAChB;QACEC,CAAC,EAAEJ,MAAM;QACTK,CAAC,EAAEJ,YAAY;QACfb,IAAI,EAAE,aAAa;QAAE;QACrBG,IAAI,EAAE,KAAK;QACXe,MAAM,EAAE;UACNC,KAAK,EAAE;QACT;MACF,CAAC,EACD;QACEH,CAAC,EAAEJ,MAAM;QACTK,CAAC,EAAEH,iBAAiB,CAACM,GAAG,CAAEC,KAAK,IAAK,CAACA,KAAK,CAAC;QAAE;QAC7CrB,IAAI,EAAE,iBAAiB;QAAE;QACzBG,IAAI,EAAE,KAAK;QACXe,MAAM,EAAE;UACNC,KAAK,EAAE;QACT;MACF,CAAC,CACF;MAED,MAAMG,MAAK,GAAI;QACbC,KAAK,EAAE,sBAAsB;QAC7BC,OAAO,EAAE,UAAU;QACnBC,MAAM,EAAE,GAAG;QACb;QACEC,KAAK,EAAE;UACLH,KAAK,EAAE,QAAQ;UACfI,QAAQ,EAAE;QACZ,CAAC;QACDC,KAAK,EAAE;UACLL,KAAK,EAAE;QACT,CAAC;QACDM,MAAM,EAAE;UACNb,CAAC,EAAE,CAAC;UACJC,CAAC,EAAE;QACL,CAAC;QACDa,aAAa,EAAE,eAAe;QAChC;QACEC,UAAU,EAAE;MACd,CAAC;MAEDhC,MAAM,CAACiC,OAAO,CAAC,4BAA4B,EAAEjB,SAAS,EAAEO,MAAM,CAAC;IACjE;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}