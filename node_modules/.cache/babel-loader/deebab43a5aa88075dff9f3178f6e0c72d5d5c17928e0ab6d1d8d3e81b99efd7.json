{"ast":null,"code":"import axios from \"axios\";\nexport default {\n  props: {\n    skills: {\n      type: Array,\n      required: true\n    }\n  },\n  data() {\n    return {\n      employee: null\n    };\n  },\n  methods: {\n    async fetchEmployeeSkill(empId) {\n      try {\n        const response = await axios.get(`http://localhost:5000/api/EmployeeSkillSection/${empId}`);\n        this.employee = response.data; // เก็บข้อมูลที่ได้จาก API\n      } catch (error) {\n        console.error(\"Error fetching employee data:\", error);\n      }\n    },\n    getSkillColor(level) {\n      if (level === 3) return \"green\";\n      if (level === 2) return \"yellow\";\n      if (level === 1) return \"red\";\n      if (level === 0) return \"gray\";\n      return \"transparent\";\n    }\n  },\n  mounted() {\n    // เรียก API และดึงข้อมูลพนักงานที่ต้องการ\n    const empId = 1989030; // ใช้ EmpID ที่ต้องการทดสอบ (ปรับเปลี่ยนตามต้องการ)\n    this.fetchEmployeeSkill(empId);\n  }\n};","map":{"version":3,"names":["axios","props","skills","type","Array","required","data","employee","methods","fetchEmployeeSkill","empId","response","get","error","console","getSkillColor","level","mounted"],"sources":["C:\\JecII\\SPFront\\src\\components\\EmployeeSkillSection.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"employee\" class=\"employee-section\">\r\n    <h3>{{ employee.Firstname }} {{ employee.Lastname }}</h3>\r\n    <div v-for=\"skill in skills\" :key=\"skill\">\r\n      <p>{{ skill }}: Level {{ employee[skill] }}</p>\r\n      <div\r\n        class=\"skill-bar\"\r\n        :style=\"{ \r\n          background: `linear-gradient(to right, ${getSkillColor(employee[skill])} ${(employee[skill] / 3) * 100}%, #ddd ${(employee[skill] / 3) * 100}%)`,\r\n          width: '100%'\r\n        }\"\r\n      ></div>\r\n    </div>\r\n  </div>\r\n  <p v-else>กรุณาเลือกพนักงาน</p>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  props: {\r\n    skills: {\r\n      type: Array,\r\n      required: true,\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      employee: null,\r\n    };\r\n  },\r\n  methods: {\r\n    async fetchEmployeeSkill(empId) {\r\n      try {\r\n        const response = await axios.get(`http://localhost:5000/api/EmployeeSkillSection/${empId}`);\r\n        this.employee = response.data;  // เก็บข้อมูลที่ได้จาก API\r\n      } catch (error) {\r\n        console.error(\"Error fetching employee data:\", error);\r\n      }\r\n    },\r\n    getSkillColor(level) {\r\n      if (level === 3) return \"green\";\r\n      if (level === 2) return \"yellow\";\r\n      if (level === 1) return \"red\";\r\n      if (level === 0) return \"gray\";\r\n      return \"transparent\";\r\n    },\r\n  },\r\n  mounted() {\r\n    // เรียก API และดึงข้อมูลพนักงานที่ต้องการ\r\n    const empId = 1989030;  // ใช้ EmpID ที่ต้องการทดสอบ (ปรับเปลี่ยนตามต้องการ)\r\n    this.fetchEmployeeSkill(empId);\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.employee-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.skill-bar {\r\n  height: 20px;\r\n  margin-bottom: 10px;\r\n  border-radius: 5px;\r\n  background-color: gray; /* Default */\r\n}\r\n</style>\r\n"],"mappings":"AAkBA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,KAAK,EAAE;IACLC,MAAM,EAAE;MACNC,IAAI,EAAEC,KAAK;MACXC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,kBAAkBA,CAACC,KAAK,EAAE;MAC9B,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMX,KAAK,CAACY,GAAG,CAAC,kDAAkDF,KAAK,EAAE,CAAC;QAC3F,IAAI,CAACH,QAAO,GAAII,QAAQ,CAACL,IAAI,EAAG;MAClC,EAAE,OAAOO,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,+BAA+B,EAAEA,KAAK,CAAC;MACvD;IACF,CAAC;IACDE,aAAaA,CAACC,KAAK,EAAE;MACnB,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,OAAO;MAC/B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,QAAQ;MAChC,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,KAAK;MAC7B,IAAIA,KAAI,KAAM,CAAC,EAAE,OAAO,MAAM;MAC9B,OAAO,aAAa;IACtB;EACF,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR;IACA,MAAMP,KAAI,GAAI,OAAO,EAAG;IACxB,IAAI,CAACD,kBAAkB,CAACC,KAAK,CAAC;EAChC;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}