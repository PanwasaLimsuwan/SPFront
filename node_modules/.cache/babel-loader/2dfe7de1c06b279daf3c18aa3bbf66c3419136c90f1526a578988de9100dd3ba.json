ue=\"ALL\">ALL</option> -->\r\n          <option v-for=\"biz in Object.keys(data)\" :key=\"biz\" :value=\"biz\">\r\n            {{ biz }}\r\n          </option>\r\n        </select>\r\n      </div>\r\n      <div id=\"training-by-biz\"></div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import Plotly from \"plotly.js\";\r\n  \r\n  export default {\r\n    name: \"TrainingByBiz\",\r\n    props: {\r\n      data: {\r\n        type: Object,\r\n        required: true,\r\n      },\r\n    },\r\n    data() {\r\n      return {\r\n        selectedBiz: \"ALL\", // ค่าเริ่มต้นเป็น ALL\r\n        filteredData: {}, // เก็บข้อมูลที่กรองแล้ว\r\n      };\r\n    },\r\n    watch: {\r\n      // หากมีการเปลี่ยนแปลงข้อมูล ให้วาดกราฟใหม่\r\n      data: {\r\n        deep: true,\r\n        handler() {\r\n          this.filterChart();\r\n        },\r\n      },\r\n    },\r\n    methods: {\r\n      filterChart() {\r\n        // ดึงข้อมูลตาม Business Unit ที่เลือก\r\n        if (this.selectedBiz in this.data) {\r\n          this.filteredData = { ...this.data[this.selectedBiz] };\r\n        } else {\r\n          console.error(\"Invalid Business Unit selected\");\r\n        }\r\n        this.drawChart(); // อัปเดตกราฟ\r\n      },\r\n      drawChart() {\r\n        const chartData = [\r\n          {\r\n            x: this.filteredData.labels,\r\n            y: this.filteredData.values,\r\n            type: \"bar\",\r\n            marker: {\r\n              color: \"purple\",\r\n            },\r\n          },\r\n        ];\r\n  \r\n        const layout = {\r\n          title: `Training Employee by Biz: ${this.selectedBiz}`,\r\n          xaxis: { title: \"Business Unit\" },\r\n          yaxis: { title: \"Employee Count\" },\r\n          paper_bgcolor: \"rgba(0,0,0,0)\", // พื้นหลังโปร่งใส\r\n        };\r\n  \r\n        Plotly.newPlot(\"training-by-biz\", chartData, layout);\r\n      },\r\n    },\r\n    mounted() {\r\n      this.filterChart(); // เรียกใช้เมื่อโหลดคอมโพเนนต์\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  #training-by-biz {\r\n    width: 100%;\r\n    height: 100%;\r\n  }\r\n  </style>\r\n  "],"mappings":";mBAAA;;uBACIA,mBAAA,CAWM,cAVJC,mBAAA,CAQM,cAPJC,mBAAA,wCAA2C,E,gBAC3CD,mBAAA,CAKS;IATjB,uBAAAE,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAIyBC,KAAA,CAAAC,WAAW,GAAAF,MAAA;IAAGG,QAAM,EAAAJ,MAAA,QAAAA,MAAA,UAAAK,IAAA,KAAEC,QAAA,CAAAC,WAAA,IAAAD,QAAA,CAAAC,WAAA,IAAAF,IAAA,CAAW;MAChDN,mBAAA,wCAAyC,G,kBACzCF,mBAAA,CAESW,SAAA,QARnBC,WAAA,CAMgCC,MAAM,CAACC,IAAI,CAACC,MAAA,CAAAC,IAAI,GAAvBC,GAAG;yBAAlBjB,mBAAA,CAES;MAFiCkB,GAAG,EAAED,GAAG;MAAGE,KAAK,EAAEF;wBACvDA,GAAG,wBAPlBG,UAAA;2FAIyBf,KAAA,CAAAC,WAAW,E,+BAO9BL,mBAAA,CAAgC;IAA3BoB,EAAE,EAAC;EAAiB,4B","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}